---
export const prerender = false;
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { isPendingHandle } from '../lib/handles';

const rider = Astro.locals.rider;
if (!rider) return Astro.redirect('/join');
if (isPendingHandle(rider.handle)) return Astro.redirect('/join');

const { env } = Astro.locals.runtime;
const counts = await env.DB.prepare(
  `SELECT
     (SELECT COUNT(*) FROM published_logs WHERE rider_id = ?1) AS flights,
     (SELECT COUNT(*) FROM flight_records fr WHERE fr.rider_id = ?1 AND fr.matched_log_slug IS NOT NULL) AS verified,
     (SELECT COUNT(*) FROM vouches WHERE vouchee_id = ?1 AND status = 'active') AS vouches,
     (SELECT COUNT(*) FROM devices WHERE rider_id = ?1 AND revoked_at IS NULL) AS devices`,
)
  .bind(rider.id)
  .first<{ flights: number; verified: number; vouches: number; devices: number }>();
const flights = counts?.flights ?? 0;
const verified = counts?.verified ?? 0;
const vouches = counts?.vouches ?? 0;
const deviceCount = counts?.devices ?? 0;

const joined = new Date(rider.created_at).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const rankLabel = rider.rank ? rider.rank.toUpperCase() : 'UNRANKED';
---

<Base
  title="Your ledger — AgentRiders"
  description="Your flights, vouches and rank, in one place."
>
  <PageHero
    eyebrow={`@${rider.handle}`}
    title={rider.display_name}
    description="Your ledger. Every flight you log and every vouch with your name on it ends up here."
    art="ranks"
    id="me-title"
    compact
  ></PageHero>

  <section class="section section--bone">
    <div class="container me-layout">
      <div class="me-grid">
        <div class="me-card">
          <p class="micro">RANK</p>
          <p class="me-card__value">{rankLabel}</p>
          <p class="me-card__fine">
            {rider.rank
              ? 'Earned, never bought.'
              : 'Fledgling unlocks with your first published flight.'}
          </p>
        </div>
        <div class="me-card">
          <p class="micro">JOINED</p>
          <p class="me-card__value">{joined}</p>
          <p class="me-card__fine">Member of the founding season.</p>
        </div>
      </div>

      <div class="me-coming">
        <div class="me-card">
          <p class="micro">FLIGHTS</p>
          <p class="me-card__value">{flights}{verified > 0 && <span class="me-card__sub"> · {verified} verified ✦</span>}</p>
          <p class="me-card__fine"><a class="text-link" href="/logs/new">Log a flight</a> or view <a class="text-link" href={`/riders/${rider.handle}`}>your profile</a>.</p>
        </div>
        <div class="me-card">
          <p class="micro">VOUCHES</p>
          <p class="me-card__value">{vouches}</p>
          <p class="me-card__fine">Received, each with a name on it. See them on <a class="text-link" href={`/riders/${rider.handle}`}>your profile</a>.</p>
        </div>
        <div class="me-card">
          <p class="micro">DEVICES</p>
          <p class="me-card__value">{deviceCount}</p>
          <p class="me-card__fine">Pair the <code>agentriders</code> CLI for verified flights. <a class="text-link" href="/me/devices">Devices &amp; records →</a></p>
        </div>
      </div>

      <form method="post" action="/api/auth/logout" class="me-signout">
        <button class="btn btn--ink" type="submit">Sign out</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .me-layout { max-width: 720px; display: flex; flex-direction: column; gap: 28px; }
  .me-grid, .me-coming { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .me-card { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--bone-line); border-left: 3px solid var(--ember); background: var(--bone-raised); }
  .me-card--ghost { border-left-color: var(--bone-line); opacity: 0.85; }
  .me-card .micro { color: var(--ash); font-size: 9px; }
  .me-card__value { font-family: var(--display); font-size: 26px; font-weight: 600; letter-spacing: -0.01em; }
  .me-card__sub { font-size: 14px; font-weight: 400; color: var(--ember-text); }
  .me-card__fine { font-size: 13px; line-height: 1.55; color: var(--text-on-bone-soft); }
  .me-signout { padding-top: 4px; }
</style>
