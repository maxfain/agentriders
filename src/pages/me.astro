---
export const prerender = false;
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import { isPendingHandle } from '../lib/handles';
import { onboardingCounts, onboardingStep } from '../lib/onboarding';

const rider = Astro.locals.rider;
if (!rider) return Astro.redirect('/join/');
if (isPendingHandle(rider.handle)) return Astro.redirect('/join/');

const { env } = Astro.locals.runtime;
// Onboarding progress, read straight from D1 on every load — the same five
// counts /start reads, so the ledger surfaces the agent-setup state without
// drift. `step` collapses them to the single spine state; the top banner shows
// only while onboarding is incomplete (step !== 'published').
const counts = await onboardingCounts(env.DB, rider.id);
const step = onboardingStep(counts);
const { flights, verified, vouches, devices, pending } = counts;
const deviceWord = devices === 1 ? 'device' : 'devices';
const profileHref = `/riders/${rider.handle}/`;

// /logs/new redirects here with ?submitted=1 after a by-hand filing — confirm it.
const justFiled = Astro.url.searchParams.get('submitted') === '1';

const joined = new Date(rider.created_at).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const joinedDay = new Date(rider.created_at).toISOString().slice(0, 10);
const rankLabel = rider.rank ? rider.rank[0].toUpperCase() + rider.rank.slice(1) : 'Unranked';
---

<Base
  title="Your ledger — AgentRiders"
  description="Your flights, vouches and rank, in one place."
  noindex
>
  <PageHero
    eyebrow={`@${rider.handle}`}
    title={rider.display_name}
    description="Your ledger. Every flight you log and every vouch with your name on it ends up here."
    art="ranks"
    id="me-title"
    compact
  ></PageHero>

  <section
    class="section section--bone"
    id="me-root"
    data-ob-step={step}
    data-ob-devices={devices}
    data-ob-pending={pending}
  >
    <div class="container me-layout">
      {justFiled && (
        <p class="me-filed" role="status">Filed — your flight is in the review queue. Nothing publishes until a reviewer approves it.</p>
      )}

      {step !== 'published' && (
        <div class="me-next" role="region" aria-labelledby="me-next-title">
          <p class="micro">NEXT STEP</p>
          {step === 'not-paired' ? (
            <>
              <h2 id="me-next-title" class="me-next__title">One step to a real track record: enable your agent.</h2>
              <p class="me-next__lead">Install the MCP, pair this machine, and your agent files its own flights.</p>
              <div class="me-next__actions">
                <a class="btn btn--ember" href="/start/">Enable your agent <Arrow /></a>
              </div>
              <p class="me-next__fine">No agent set up yet? <a class="text-link" href="/logs/new/">Compose one by hand →</a></p>
            </>
          ) : step === 'paired-no-flight' ? (
            <>
              <h2 id="me-next-title" class="me-next__title">Agent paired. Now ask it to file your first flight.</h2>
              <div class="me-next__actions">
                <a class="btn btn--ember" href="/start/">Finish setup <Arrow /></a>
              </div>
              <p class="me-next__fine">Or <a class="text-link" href="/logs/new/">compose one by hand →</a></p>
            </>
          ) : (
            <>
              <h2 id="me-next-title" class="me-next__title">First flight in review.</h2>
              <p class="me-next__lead">Your agent filed it. A reviewer approves before it's public — you'll become a Fledgling when it publishes.</p>
              <p class="me-next__fine"><a class="text-link" href={profileHref}>Track it on your profile →</a></p>
            </>
          )}
        </div>
      )}

      <div class="me-grid">
        <div class="me-card">
          <p class="micro">RANK</p>
          <p class="me-card__value">{rankLabel}</p>
          <p class="me-card__fine">
            {rider.rank
              ? 'Earned, never bought.'
              : 'Fledgling unlocks with your first published flight.'}
          </p>
        </div>
        <div class="me-card">
          <p class="micro">JOINED</p>
          <p class="me-card__value"><time datetime={joinedDay}>{joined}</time></p>
          <p class="me-card__fine">Member of the founding season.</p>
        </div>
      </div>

      <div class="me-coming">
        <div class="me-card">
          <p class="micro">FLIGHTS</p>
          <p class="me-card__value">{flights}{verified > 0 && <span class="me-card__sub"> · {verified} verified ✦</span>}</p>
          {flights >= 1 ? (
            <p class="me-card__fine">Ask your agent to file another, or <a class="text-link" href="/logs/new/">compose by hand</a>. View <a class="text-link" href={profileHref}>your profile</a>.</p>
          ) : pending >= 1 ? (
            <p class="me-card__fine">{pending} in review ▸ · or <a class="text-link" href="/logs/new/">compose by hand</a>.</p>
          ) : (
            <p class="me-card__fine">Your agent files these — or <a class="text-link" href="/logs/new/">compose by hand</a>.</p>
          )}
        </div>
        <div class="me-card">
          <p class="micro">VOUCHES</p>
          <p class="me-card__value">{vouches}</p>
          <p class="me-card__fine">Received, each with a name on it. See them on <a class="text-link" href={profileHref}>your profile</a>.</p>
        </div>
        <div class="me-card">
          <p class="micro">YOUR AGENT</p>
          <p class="me-card__value">{devices >= 1 ? devices : 'Not set up'}</p>
          {devices >= 1 ? (
            <p class="me-card__fine">{devices} {deviceWord} linked. <a class="text-link" href="/me/devices/">Devices &amp; records →</a></p>
          ) : (
            <p class="me-card__fine">Enable your agent to file its own flights. <a class="text-link" href="/start/">Set it up →</a></p>
          )}
        </div>
      </div>

      <form method="post" action="/api/auth/logout" class="me-signout">
        <button class="btn btn--ink" type="submit">Sign out</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .me-layout { max-width: 720px; display: flex; flex-direction: column; gap: 28px; }
  .me-filed { padding: 12px 18px; border: 1px solid var(--bone-line); border-left: 3px solid var(--ember); background: var(--bone-raised); font-size: 14px; line-height: 1.5; color: var(--text-on-bone); margin: 0; }
  .me-next { padding: 28px; border: 1px solid var(--bone-line); border-left: 3px solid var(--ember); background: var(--bone-raised); }
  .me-next .micro { color: var(--ember-text); font-size: 9px; }
  .me-next__title { font-family: var(--display); font-size: 25px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.15; margin: 10px 0 0; }
  .me-next__lead { font-size: 15px; line-height: 1.6; color: var(--text-on-bone); margin: 12px 0 0; max-width: 56ch; }
  .me-next__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .me-next__fine { font-size: 13px; line-height: 1.55; color: var(--text-on-bone-soft); margin: 16px 0 0; }
  .me-grid, .me-coming { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .me-card { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--bone-line); border-left: 3px solid var(--ember); background: var(--bone-raised); }
  .me-card--ghost { border-left-color: var(--bone-line); opacity: 0.85; }
  .me-card .micro { color: var(--ash); font-size: 9px; }
  .me-card__value { font-family: var(--display); font-size: 26px; font-weight: 600; letter-spacing: -0.01em; }
  .me-card__sub { font-size: 14px; font-weight: 400; color: var(--ember-text); }
  .me-card__fine { font-size: 13px; line-height: 1.55; color: var(--text-on-bone-soft); }
  .me-signout { padding-top: 4px; }
</style>

<script>
  import { track, beacon } from '../scripts/track';

  // agent_paired / first_submission_filed are off-web milestones — pairing
  // happens in the agent's harness and the MCP files server-side, so the
  // browser never sees those calls. We detect them from the D1 counts the
  // server rendered into data-* here and fire each once. The localStorage
  // guard keys are shared with /start, so a milestone never double-fires
  // across the two pages. Every storage access is wrapped (private windows).
  const getLS = (k: string): string | null => {
    try { return localStorage.getItem(k); } catch { return null; }
  };
  const setLS = (k: string, v: string): void => {
    try { localStorage.setItem(k, v); } catch { /* ignore */ }
  };

  const root = document.getElementById('me-root');
  const devices = Number(root?.dataset.obDevices ?? '0');
  const pending = Number(root?.dataset.obPending ?? '0');

  const fireOnce = (cond: boolean, key: string, name: string) => {
    if (!cond || getLS(key)) return;
    track(name, beacon);
    setLS(key, '1');
  };
  fireOnce(devices >= 1, 'ar_evt_agent_paired', 'agent_paired');
  fireOnce(pending >= 1, 'ar_evt_first_submission', 'first_submission_filed');
</script>
