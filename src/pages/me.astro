---
export const prerender = false;
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import { isPendingHandle } from '../lib/handles';

const rider = Astro.locals.rider;
if (!rider) return Astro.redirect('/join/');
if (isPendingHandle(rider.handle)) return Astro.redirect('/join/');

const { env } = Astro.locals.runtime;
const counts = await env.DB.prepare(
  `SELECT
     (SELECT COUNT(*) FROM published_logs WHERE rider_id = ?1) AS flights,
     (SELECT COUNT(*) FROM flight_records fr WHERE fr.rider_id = ?1 AND fr.matched_log_slug IS NOT NULL) AS verified,
     (SELECT COUNT(*) FROM vouches WHERE vouchee_id = ?1 AND status = 'active') AS vouches,
     (SELECT COUNT(*) FROM devices WHERE rider_id = ?1 AND revoked_at IS NULL) AS devices`,
)
  .bind(rider.id)
  .first<{ flights: number; verified: number; vouches: number; devices: number }>();
const flights = counts?.flights ?? 0;
const verified = counts?.verified ?? 0;
const vouches = counts?.vouches ?? 0;
const deviceCount = counts?.devices ?? 0;

const joined = new Date(rider.created_at).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const joinedDay = new Date(rider.created_at).toISOString().slice(0, 10);
const rankLabel = rider.rank ? rider.rank[0].toUpperCase() + rider.rank.slice(1) : 'Unranked';
// The ledger starts empty, so /me opens with a next step, not a wall of
// zeroes: a new rider is sent to their first flight; a Fledgling who has
// flown is pointed at the next one and the ladder to Rider.
const isNew = flights === 0;
const notYetRider = rider.rank !== 'rider' && rider.rank !== 'wingleader';
---

<Base
  title="Your ledger — AgentRiders"
  description="Your flights, vouches and rank, in one place."
  noindex
>
  <PageHero
    eyebrow={`@${rider.handle}`}
    title={rider.display_name}
    description="Your ledger. Every flight you log and every vouch with your name on it ends up here."
    art="ranks"
    id="me-title"
    compact
  ></PageHero>

  <section class="section section--bone">
    <div class="container me-layout">
      <div class="me-next" role="region" aria-labelledby="me-next-title">
        <p class="micro">NEXT STEP</p>
        {isNew ? (
          <>
            <h2 id="me-next-title" class="me-next__title">You're in, @{rider.handle}. Now fly your first flight.</h2>
            <p class="me-next__lead">Your ledger is empty until you fly. A first flight takes about 25 minutes: give one real task to an AI agent, judge the landing, and log what happened. That is what earns Fledgling.</p>
            <div class="me-next__actions">
              <a class="btn btn--ember" href="/training/your-first-flight/">Start your first flight <Arrow /></a>
              <a class="btn btn--ink" href="/logs/new/">Already flew? Log it</a>
            </div>
            <p class="me-next__fine">Run agents in Claude Code or Cursor? <a class="text-link" href="/me/devices/">Pair the <code>agentriders</code> CLI</a> to file verified flights straight from a session.</p>
          </>
        ) : notYetRider ? (
          <>
            <h2 id="me-next-title" class="me-next__title">{flights} {flights === 1 ? 'flight' : 'flights'} logged. Keep flying.</h2>
            <p class="me-next__lead">Rider unlocks at 20 published flights and 2 vouches from riders who already hold Rider. Every flight you log and every honest vouch moves you up the ladder.</p>
            <div class="me-next__actions">
              <a class="btn btn--ember" href="/logs/new/">Log another flight <Arrow /></a>
              <a class="btn btn--ink" href={`/riders/${rider.handle}/`}>View your profile</a>
            </div>
            <p class="me-next__fine">New to the ladder? See <a class="text-link" href="/riders/ranks/">how ranks are earned</a>.</p>
          </>
        ) : (
          <>
            <h2 id="me-next-title" class="me-next__title">You hold the reins, {rankLabel}.</h2>
            <p class="me-next__lead">Log your flights, vouch for riders you have flown beside, and keep the record honest. The directory is built from ledgers like yours.</p>
            <div class="me-next__actions">
              <a class="btn btn--ember" href="/logs/new/">Log a flight <Arrow /></a>
              <a class="btn btn--ink" href={`/riders/${rider.handle}/`}>View your profile</a>
            </div>
          </>
        )}
      </div>

      <div class="me-grid">
        <div class="me-card">
          <p class="micro">RANK</p>
          <p class="me-card__value">{rankLabel}</p>
          <p class="me-card__fine">
            {rider.rank
              ? 'Earned, never bought.'
              : 'Fledgling unlocks with your first published flight.'}
          </p>
        </div>
        <div class="me-card">
          <p class="micro">JOINED</p>
          <p class="me-card__value"><time datetime={joinedDay}>{joined}</time></p>
          <p class="me-card__fine">Member of the founding season.</p>
        </div>
      </div>

      <div class="me-coming">
        <div class="me-card">
          <p class="micro">FLIGHTS</p>
          <p class="me-card__value">{flights}{verified > 0 && <span class="me-card__sub"> · {verified} verified ✦</span>}</p>
          <p class="me-card__fine"><a class="text-link" href="/logs/new/">Log a flight</a> or view <a class="text-link" href={`/riders/${rider.handle}/`}>your profile</a>.</p>
        </div>
        <div class="me-card">
          <p class="micro">VOUCHES</p>
          <p class="me-card__value">{vouches}</p>
          <p class="me-card__fine">Received, each with a name on it. See them on <a class="text-link" href={`/riders/${rider.handle}/`}>your profile</a>.</p>
        </div>
        <div class="me-card">
          <p class="micro">DEVICES</p>
          <p class="me-card__value">{deviceCount}</p>
          <p class="me-card__fine">Pair the <code>agentriders</code> CLI for verified flights. <a class="text-link" href="/me/devices/">Devices &amp; records →</a></p>
        </div>
      </div>

      <form method="post" action="/api/auth/logout" class="me-signout">
        <button class="btn btn--ink" type="submit">Sign out</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .me-layout { max-width: 720px; display: flex; flex-direction: column; gap: 28px; }
  .me-next { padding: 28px; border: 1px solid var(--bone-line); border-left: 3px solid var(--ember); background: var(--bone-raised); }
  .me-next .micro { color: var(--ember-text); font-size: 9px; }
  .me-next__title { font-family: var(--display); font-size: 25px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.15; margin: 10px 0 0; }
  .me-next__lead { font-size: 15px; line-height: 1.6; color: var(--text-on-bone); margin: 12px 0 0; max-width: 56ch; }
  .me-next__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .me-next__fine { font-size: 13px; line-height: 1.55; color: var(--text-on-bone-soft); margin: 16px 0 0; }
  .me-grid, .me-coming { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .me-card { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--bone-line); border-left: 3px solid var(--ember); background: var(--bone-raised); }
  .me-card--ghost { border-left-color: var(--bone-line); opacity: 0.85; }
  .me-card .micro { color: var(--ash); font-size: 9px; }
  .me-card__value { font-family: var(--display); font-size: 26px; font-weight: 600; letter-spacing: -0.01em; }
  .me-card__sub { font-size: 14px; font-weight: 400; color: var(--ember-text); }
  .me-card__fine { font-size: 13px; line-height: 1.55; color: var(--text-on-bone-soft); }
  .me-signout { padding-top: 4px; }
</style>
