---
import { getCollection, render } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import ChapterRail from '../../components/ChapterRail.astro';
import FieldDiagram from '../../components/FieldDiagram.astro';
import { breadcrumbs, techArticle, smarten } from '../../lib/seo';

export async function getStaticPaths() {
  const chapters = await getCollection('manual', ({ data }) => !data.draft);
  return chapters.map((chapter) => ({ params: { slug: chapter.id }, props: { chapter } }));
}

const { chapter } = Astro.props;
const { Content, headings } = await render(chapter);
const d = chapter.data;
const isGuide = d.kind === 'guide';
// Chapters are the numbered sequence; guides are unnumbered siblings. The sort,
// prev/next and rail only ever see chapters, so the numbered rail is unchanged.
const chapters = (await getCollection('manual', ({ data }) => !data.draft && data.kind === 'chapter')).sort((a, b) => (a.data.chapter ?? 0) - (b.data.chapter ?? 0));
const position = chapters.findIndex((item) => item.id === chapter.id);
const previous = chapters[position - 1];
const next = chapters[position + 1];
const hasBody = chapter.body ? chapter.body.replace(/<!--[\s\S]*?-->/g, '').trim().length > 0 : false;
// The H1 is the short title (before the colon) and the JSON-LD headline
// mirrors it; the <title> leads with the industry term when the chapter has
// one (seoTitle), with only " — AgentRiders" after it so the clamp never cuts.
const shortTitle = d.title.split(':')[0];
const published = d.published.toISOString().slice(0, 10);
const updated = d.updated.toISOString().slice(0, 10);
const path = `/manual/${chapter.id}/`;
const lastVerified = d.lastVerified ? d.lastVerified.toISOString().slice(0, 10) : undefined;
// A guide's "Related" list is the chapters its own body already links, in
// chapter order — real relevance, not a curated guess (docs/seo-aeo-plan.md §4.3).
const guideRelated = isGuide ? chapters.filter((ch) => (chapter.body ?? '').includes(`/manual/${ch.id}/`)) : [];
// The questions section is an H2 of the page, so the rail lists it with the body's.
const railHeadings = d.faq.length > 0 ? [...headings, { depth: 2, slug: 'faq-title', text: 'Questions riders ask' }] : headings;
// One line, true for every chapter at once: the S1 rewrite (docs/seo-aeo-plan.md §5.2).
const changelog = 'Updated 2026-10-16: literal titles, summary and questions added.';
const jsonLd = [
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'The Field Manual', path: '/manual/' }, { name: shortTitle, path }]),
  techArticle({
    headline: shortTitle, description: d.description, path,
    datePublished: d.published, dateModified: d.updated,
    authorName: d.author, authorPath: '/about/', seriesName: 'The Field Manual', position: d.chapter,
  }),
];
---

<Base title={`${d.seoTitle ?? shortTitle} — AgentRiders`} description={d.description} ogType="article" publishedTime={d.published} modifiedTime={d.updated} jsonLd={jsonLd}>
  <PageHero eyebrow={isGuide ? 'Field Manual / Guide' : `Chapter ${String(d.chapter).padStart(2, '0')} / The Field Manual`} title={shortTitle} art="book" compact>
    {hasBody ? (
      <>
        <p class="summary">{smarten(d.summary)}</p>
        <p class="page-hero__meta">By <a href="/about/#author" rel="author">{d.author}</a> · Published <time datetime={published}>{published}</time> · Updated <time datetime={updated}>{updated}</time></p>
      </>
    ) : (
      <p class="page-hero__meta">CHAPTER IN PROGRESS</p>
    )}
  </PageHero>

  <section class="section section--bone">
    <div class="container chapter-reading">
      <ChapterRail current={chapter.id} headings={railHeadings} onPageLabel={isGuide ? 'IN THIS GUIDE' : undefined} />
      <div class="chapter-reading__body">
      {isGuide ? (lastVerified && <p class="doc-verified">Last verified <time datetime={lastVerified}>{lastVerified}</time></p>) : <FieldDiagram chapter={d.chapter} />}
      {hasBody ? (
        <div class="prose">
          <Content />
        </div>
      ) : (
        <div class="chapter-in-progress"><p class="micro">CHAPTER IN PROGRESS</p><h2>Still in the field.</h2><p>This chapter is being written from real flights. Read the <a href="/manual/evals/">Evals chapter</a> while this one takes shape, or visit the <a href="/flight-log/">Flight Log</a> for newsletter availability.</p></div>
      )}
      {d.faq.length > 0 && (
        <section class="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Questions riders ask</h2>
          {d.faq.map((item) => <><h3>{smarten(item.q)}</h3><p>{smarten(item.a)}</p></>)}
          <p class="changelog">{changelog}</p>
        </section>
      )}
      {isGuide ? (
        <>
          {d.sources.length > 0 && (
            <section class="doc-sources" aria-labelledby="sources-title">
              <h2 id="sources-title">Sources</h2>
              <ul>{d.sources.map((s) => <li><a href={s}>{s.replace(/^https?:\/\//, '')}</a></li>)}</ul>
            </section>
          )}
          <nav class="doc-related" aria-label="Related chapters">
            <h2>Related</h2>
            <div class="doc-related__links">
              <a href="/manual/">The Field Manual</a>
              {guideRelated.map((ch) => <a href={`/manual/${ch.id}/`}>{ch.data.title.split(':')[0]}</a>)}
            </div>
          </nav>
        </>
      ) : (
      <nav class="chapter-navigation" aria-label="Chapters">
        <a href="/manual/">← All chapters</a>
        {previous && <a href={`/manual/${previous.id}/`}>Previous chapter</a>}
        {next && <a href={`/manual/${next.id}/`}>Next: {next.data.title.split(':')[0]} →</a>}
      </nav>
      )}
      </div>
    </div>
  </section>
</Base>
