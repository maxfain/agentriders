---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const chapters = await getCollection('manual', ({ data }) => !data.draft);
  return chapters.map((chapter) => ({ params: { slug: chapter.id }, props: { chapter } }));
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);
const d = chapter.data;
const hasBody = chapter.body ? chapter.body.replace(/<!--[\s\S]*?-->/g, '').trim().length > 0 : false;
---

<Base title={`${d.title} — Field Manual — AgentRiders`} description={d.description}>
  <section class="section section--ink page-hero">
    <div class="container">
      <p class="eyebrow">Chapter {String(d.chapter).padStart(2, '0')}</p>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <p class="page-hero__meta">Field Manual · updated {d.updated.toISOString().slice(0, 10)}</p>
    </div>
  </section>

  <section class="section section--bone">
    <div class="container stack">
      {hasBody ? (
        <div class="prose">
          <Content />
        </div>
      ) : (
        <p class="empty">This chapter is being written from real flights. Subscribe to the <a href="/flight-log">Flight Log</a> to hear when it lands.</p>
      )}
      <p class="stack__note"><a href="/manual">← Back to the Manual</a></p>
    </div>
  </section>
</Base>
