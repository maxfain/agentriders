---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import PageCoda from '../../components/PageCoda.astro';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { breadcrumbs } from '../../lib/seo';

const chapters = (await getCollection('manual', ({ data }) => !data.draft && data.kind === 'chapter')).sort(
  (a, b) => (a.data.chapter ?? 0) - (b.data.chapter ?? 0),
);
// The three S2 guides (docs/seo-aeo-plan.md §3.3), in reading order: stop a
// run, cap its spend, then compare the four mounts.
const GUIDE_ORDER = ['kill-switch', 'spend-cap', 'scope-cap-kill-compared'];
const guides = (await getCollection('manual', ({ data }) => !data.draft && data.kind === 'guide')).sort(
  (a, b) => GUIDE_ORDER.indexOf(a.id) - GUIDE_ORDER.indexOf(b.id),
);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Base
  title="Field Manual — AgentRiders"
  description="Practical references for running AI agents: scope, permissions, budgets, stop conditions, review loops, and learning from failure."
  jsonLd={breadcrumbs([{ name: 'Home', path: '/' }, { name: 'The Field Manual', path: '/manual/' }])}
>
  <PageHero eyebrow="The Field Manual" title="Everything we know about holding the reins." description="Practical references for the decisions every rider makes: what to delegate, where to draw the boundary, and how to know the work is done." art="book" id="manual-title"></PageHero>

  <section class="section section--bone" aria-label="Chapters">
    <div class="container manual-library">
      <aside class="manual-intro"><Icon name="skills" size={40}/><p class="micro">THE CRAFT OF RIDING</p><h2>Read it.<br />Try it.<br /><em>Log it.</em></h2><p>The Manual is your reference shelf. Flight School turns these ideas into six guided lessons, with a small exercise and a useful artifact at every step.</p><a class="text-link" href="/training/">Start Flight School ↗</a><a class="text-link" href="/logs/template/">Keep a flight record ↗</a></aside>
      <ol class="chapters">
        {chapters.map((ch) => (
          <li>
            <article class="chapter">
              <p class="chapter__num">{String(ch.data.chapter).padStart(2, '0')}</p>
              <div class="chapter__body">
                {ch.data.startHere && <p class="tag">Start here</p>}
                <h2><a href={`/manual/${ch.id}/`}>{ch.data.title}</a></h2>
                <p>{ch.data.description}</p>
                <p class="chapter__meta">{ch.body?.replace(/<!--[\s\S]*?-->/g, "").trim() ? <>Updated <time datetime={fmt(ch.data.updated)}>{fmt(ch.data.updated)}</time></> : "Chapter in progress"}</p>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
    {guides.length > 0 && (
      <div class="container manual-guides">
        <div class="manual-guides__head">
          <p class="micro">FIELD MANUAL / GUIDES</p>
          <h2>Reference guides</h2>
          <p>Standalone references that sit beside the chapters: how to stop a run, how to cap what it spends, and how the four mounts compare.</p>
        </div>
        <ul class="guide-list">
          {guides.map((g) => (
            <li>
              <h3><a href={`/manual/${g.id}/`}>{g.data.title.split(':')[0]}</a></h3>
              <p>{g.data.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
  <PageCoda title="Put the craft into practice." description="One task. One outcome. One honest record." href="/logs/template/" label="Log your first flight" />
</Base>
