---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { rankEarnedAt } from '../../lib/ranks';
import { canVouch, vouchesReceived, vouchesGiven, existingVouch } from '../../lib/vouches';
import { riderEvalStats } from '../../lib/flight-records';
import { isAdmin } from '../../lib/admin';
import type { RiderRow } from '../../lib/session';
import { HANDLE_REGEX } from '../../lib/handles';
import { breadcrumbs, profilePage } from '../../lib/seo';

// Public rider profile: identity, rank + when it was earned, the flight
// record, and vouches (received and given, each with a name on it). A
// signed-in Rider sees a vouch form. Verified-flight stats arrive in M4.
// Banned or unknown riders 404; the literal /riders/directory route wins.
// Anonymous responses carry no Cache-Control of their own, so the
// middleware's public rule applies and the profile renders in full signed out.
const { env } = Astro.locals.runtime;
const viewer = Astro.locals.rider;
const handle = (Astro.params.handle ?? '').toLowerCase();

// Anything that is not a handle shape is a 404 before any redirect or lookup:
// the param arrives decoded, and a Location header built from it could
// otherwise carry CR/LF (a 500) or a backslash (a needless hop).
if (!HANDLE_REGEX.test(handle)) return new Response(null, { status: 404 });

// One URL per rider: a mixed-case handle is the same profile, so it 301s to
// the lowercase form before any lookup. (The middleware folds the slash-less
// /riders/MaxCR into one hop; this covers /riders/MaxCR/.)
if (Astro.params.handle !== handle) return Astro.redirect(`/riders/${handle}/`, 301);

const viewerIsAdmin = isAdmin(viewer);

const rider = await env.DB.prepare(
  "SELECT id, handle, display_name, bio, rank, is_admin, banned_at, created_at FROM riders WHERE handle = ? AND handle NOT LIKE 'pending-%'",
)
  .bind(handle)
  .first<RiderRow>();

// Banned riders 404 for everyone except admins (who can see them to unban).
// A bodiless 404 makes Astro serve the prerendered, branded /404 page under
// this status; Astro.rewrite('/404') throws here, because an on-demand route
// can't rewrite to a static one on this adapter (see middleware.ts).
if (!rider || (rider.banned_at && !viewerIsAdmin)) {
  return new Response(null, { status: 404 });
}

type Flight = { slug: string; title: string; date: string; task: string; outcome: string; burns_count: number };
const flights = (
  await env.DB.prepare(
    'SELECT slug, title, date, task, outcome, burns_count FROM published_logs WHERE rider_id = ? ORDER BY date DESC',
  )
    .bind(rider.id)
    .all<Flight>()
).results ?? [];

const received = await vouchesReceived(env.DB, rider.id);
const given = await vouchesGiven(env.DB, rider.id);
const earnedAt = rider.rank ? await rankEarnedAt(env.DB, rider.id, rider.rank) : null;
const evalStats = await riderEvalStats(env.DB, rider.id);

const isSelf = viewer?.id === rider.id;
const viewerCanVouch = !!viewer && !isSelf && canVouch(viewer.rank);
const myVouch = viewerCanVouch ? await existingVouch(env.DB, viewer!.id, rider.id) : null;
const alreadyVouched = myVouch?.status === 'active';
const vouchRemoved = myVouch?.status === 'removed';

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
// Machine-readable forms for <time datetime>: the day, or the month for "Joined".
const day = (iso: string) => new Date(iso).toISOString().slice(0, 10);
// Short month + title-case rank: these sit in narrow stat cards, and uppercase
// display type ("WINGLEADER") is wide enough to overflow a card on a laptop.
const joined = new Date(rider.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
const rankLabel = rider.rank ? rider.rank[0].toUpperCase() + rider.rank.slice(1) : 'Unranked';
const landed = flights.filter((f) => f.outcome === 'landed').length;
const flightsLabel = `${flights.length} ${flights.length === 1 ? 'flight' : 'flights'}`;

// Index gate (docs/seo-aeo-plan.md §4.4): a profile is indexable from its
// first published flight. The ProfilePage mirrors the stat cards.
const path = `/riders/${rider.handle}/`;
const jsonLd = [
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'The Riders', path: '/riders/' }, { name: `@${rider.handle}`, path }]),
  profilePage({
    name: rider.display_name, handle: rider.handle, path, description: rider.bio ?? undefined,
    dateCreated: day(rider.created_at), dateModified: flights[0]?.date,
    flights: flights.length, vouches: received.length,
  }),
];
---

<Base title={`${rider.display_name} (@${rider.handle}): ${flightsLabel}, ${rankLabel} — AgentRiders`} description={`${rider.display_name}'s flight record: ${flights.length} published ${flights.length === 1 ? 'flight' : 'flights'}, ${received.length} ${received.length === 1 ? 'vouch' : 'vouches'}.`} noindex={flights.length === 0} jsonLd={jsonLd}>
  <PageHero eyebrow={`@${rider.handle}`} title={rider.display_name} description={rider.bio ?? undefined} art="ranks" id="rider-title" compact></PageHero>

  <section class="section section--bone">
    <div class="container rider-profile">
      {rider.banned_at && viewerIsAdmin && (
        <p class="rider-banned" role="alert">This rider is banned (hidden from the public). Admin view only.</p>
      )}
      <dl class="rider-stats">
        <div><dt>Rank</dt><dd>{rankLabel}</dd>{earnedAt && <p class="rider-stats__fine">earned <time datetime={day(earnedAt)}>{fmt(earnedAt)}</time></p>}</div>
        <div><dt>Flights</dt><dd>{flights.length}</dd>{evalStats.verified > 0 && <p class="rider-stats__fine">{evalStats.verified} verified ✦</p>}</div>
        <div><dt>Landed</dt><dd>{landed}</dd></div>
        <div><dt>Vouches</dt><dd>{received.length}</dd></div>
        <div><dt>Joined</dt><dd><time datetime={day(rider.created_at).slice(0, 7)}>{joined}</time></dd></div>
      </dl>

      {(evalStats.verified > 0 || evalStats.evalRuns > 0) && (
        <div class="rider-evals">
          <p class="micro">EVAL DISCIPLINE <span class="rider-evals__hint">— self-reported, signed by the rider’s device · display only, never a rank shortcut</span></p>
          <div class="rider-evals__row">
            <span><strong>{evalStats.verified}</strong> verified {evalStats.verified === 1 ? 'flight' : 'flights'}</span>
            {evalStats.evalRuns > 0 && <span><strong>{evalStats.evalRuns}</strong> eval {evalStats.evalRuns === 1 ? 'run' : 'runs'}</span>}
            {evalStats.bestScore > 0 && <span>best score <strong>{evalStats.bestScore}</strong></span>}
            {evalStats.frameworks.length > 0 && <span class="rider-evals__fw">{evalStats.frameworks.join(' · ')}</span>}
          </div>
        </div>
      )}

      <div class="rider-cols">
        <div class="rider-col">
          <h2 class="rider-h2">Flights</h2>
          {flights.length === 0 ? (
            <p class="rider-empty">No published flights yet.</p>
          ) : (
            <ul class="rider-flights">
              {flights.map((f) => (
                <li>
                  <a href={`/logs/${f.slug}/`}>
                    <span class="rider-flights__name">{f.title}</span>
                    <span class="rider-flights__meta"><time datetime={f.date}>{f.date}</time> · {f.task} · {f.outcome}{f.burns_count > 0 ? ` · ${f.burns_count} ${f.burns_count === 1 ? 'burn' : 'burns'}` : ''}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="rider-col">
          <h2 class="rider-h2">Vouches <span class="rider-h2__hint">— every one has a name on it</span></h2>

          {viewer && !isSelf && !canVouch(viewer.rank) && (
            <p class="rider-vouchnote">Vouching opens at Rider. Keep flying.</p>
          )}
          {viewerCanVouch && vouchRemoved && (
            <p class="rider-vouchnote">Your vouch for @{rider.handle} was removed by moderation and can't be remade.</p>
          )}
          {viewerCanVouch && !alreadyVouched && !vouchRemoved && (
            <form class="vouch-form" id="vouch-form" data-handle={rider.handle}>
              <label for="vouch-statement">Vouch for @{rider.handle}</label>
              <textarea id="vouch-statement" maxlength="500" rows="3" required placeholder="What have you seen them do? This is public and signed with your name."></textarea>
              <div class="vouch-form__row">
                <button type="submit" class="btn btn--ember">Put your name on it</button>
                <span class="vouch-form__status" id="vouch-status" role="status"></span>
              </div>
            </form>
          )}
          {viewerCanVouch && alreadyVouched && (
            <p class="rider-vouchnote">You vouch for @{rider.handle}. ✦</p>
          )}

          {received.length === 0 ? (
            <p class="rider-empty">No vouches yet.</p>
          ) : (
            <ul class="vouch-list">
              {received.map((v) => (
                <li class="vouch">
                  <p class="vouch__statement">“{v.statement}”</p>
                  <p class="vouch__by"><a href={`/riders/${v.handle}/`}>@{v.handle}</a>{v.rank && <span class="vouch__rank">{v.rank}</span>} · <time datetime={day(v.created_at)}>{fmt(v.created_at)}</time>{viewerIsAdmin &&<button type="button" class="vouch-remove" data-id={v.id} aria-label="Remove this vouch (moderation)">remove</button>}</p>
                </li>
              ))}
            </ul>
          )}

          {given.length > 0 && (
            <>
              <h3 class="rider-h3">Vouches given</h3>
              <ul class="vouch-list vouch-list--given">
                {given.map((v) => (
                  <li class="vouch">
                    <p class="vouch__statement">“{v.statement}”</p>
                    <p class="vouch__by">for <a href={`/riders/${v.handle}/`}>@{v.handle}</a> · <time datetime={day(v.created_at)}>{fmt(v.created_at)}</time>{isSelf &&<button type="button" class="vouch-revoke" data-id={v.id} aria-label="Revoke this vouch">revoke</button>}</p>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      </div>

      {viewerIsAdmin && !isSelf && (
        <div class="rider-admin" data-handle={rider.handle}>
          <p class="micro">ADMIN</p>
          <div class="rider-admin__row">
            <label for="admin-rank">Set rank</label>
            <select id="admin-rank">
              <option value="" selected={!rider.rank}>unranked</option>
              <option value="fledgling" selected={rider.rank === 'fledgling'}>fledgling</option>
              <option value="rider" selected={rider.rank === 'rider'}>rider</option>
              <option value="wingleader" selected={rider.rank === 'wingleader'}>wingleader</option>
            </select>
            <button type="button" id="admin-grant" class="btn btn--ink">Grant</button>
            {rider.banned_at ? (
              <button type="button" id="admin-ban" data-banned="1" class="btn btn--ink">Unban</button>
            ) : (
              <button type="button" id="admin-ban" data-banned="0" class="btn btn--ink">Ban rider</button>
            )}
          </div>
          <p class="rider-admin__status" id="admin-status" role="status"></p>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .rider-profile { max-width: 920px; display: flex; flex-direction: column; gap: 30px; }
  .rider-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(136px, 1fr)); gap: 16px; margin: 0; }
  .rider-stats > div { min-width: 0; container-type: inline-size; border: 1px solid var(--bone-line); border-left: 3px solid var(--ember); background: var(--bone-raised); padding: 16px 18px; }
  .rider-stats dt { font-family: var(--mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ash); }
  /* Values scale with the card: "Wingleader" (the longest rank) is ~5.5× the
     font size wide in the display face, so 17.5cqw keeps it inside the card
     at laptop widths where five cards share the row. */
  .rider-stats dd { margin: 6px 0 0; font-family: var(--display); font-size: clamp(16px, 17.5cqw, 22px); font-weight: 600; }
  .rider-stats__fine { margin: 4px 0 0; font-size: 11px; color: var(--text-on-bone-soft); }
  .rider-evals { border: 1px solid var(--bone-line); border-left: 3px solid var(--ember); background: var(--bone-raised); padding: 16px 18px; }
  .rider-evals .micro { color: var(--ash); font-size: 9px; }
  .rider-evals__hint { font-family: var(--body); font-size: 11px; text-transform: none; letter-spacing: 0; color: var(--text-on-bone-soft); }
  .rider-evals__row { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 10px; font-size: 14px; color: var(--text-on-bone-soft); }
  .rider-evals__row strong { font-family: var(--display); font-size: 18px; color: var(--text-on-bone); }
  .rider-evals__fw { font-family: var(--mono); font-size: 12px; }
  .rider-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
  .rider-h2 { font-family: var(--display); font-size: 22px; margin-bottom: 14px; }
  .rider-h2__hint { font-family: var(--body); font-size: 13px; font-weight: 400; color: var(--text-on-bone-soft); }
  .rider-h3 { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ash); margin: 22px 0 12px; }
  .rider-empty, .rider-vouchnote { color: var(--text-on-bone-soft); font-size: 14px; }
  .rider-flights { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .rider-flights a { display: flex; flex-direction: column; gap: 3px; padding: 15px 18px; border: 1px solid var(--bone-line); background: var(--bone-raised); text-decoration: none; color: var(--text-on-bone); }
  .rider-flights a:hover { border-color: var(--ink); }
  .rider-flights__name { font-family: var(--display); font-size: 18px; font-weight: 600; }
  .rider-flights__meta { font-size: 13px; color: var(--text-on-bone-soft); }
  .vouch-form { display: flex; flex-direction: column; gap: 10px; padding: 18px; border: 1px solid var(--bone-line); border-left: 3px solid var(--ember); background: var(--bone-raised); margin-bottom: 20px; }
  .vouch-form label { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ash); }
  .vouch-form textarea { font-family: inherit; font-size: 15px; padding: 11px 13px; border: 1px solid var(--bone-line); background: var(--bone); color: var(--text-on-bone); border-radius: var(--radius); resize: vertical; }
  .vouch-form__row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .vouch-form__status { font-size: 13px; color: var(--text-on-bone-soft); }
  .vouch-list { list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .vouch { border-left: 2px solid var(--bone-line); padding-left: 14px; }
  .vouch__statement { font-size: 16px; line-height: 1.5; }
  .vouch__by { font-size: 13px; color: var(--text-on-bone-soft); margin-top: 4px; }
  .vouch__by a { color: var(--ember-text); }
  .vouch__rank { margin-left: 8px; font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em; border: 1px solid var(--bone-line); padding: 1px 6px; border-radius: 3px; }
  .vouch-revoke, .vouch-remove { margin-left: 10px; background: none; border: none; color: var(--ember-text); cursor: pointer; font-size: 12px; text-decoration: underline; padding: 0; }
  .rider-banned { padding: 12px 16px; border-left: 3px solid var(--ember); background: var(--bone-raised); font-size: 14px; }
  .rider-admin { border: 1px dashed var(--bone-line); padding: 16px 18px; border-radius: var(--radius); }
  .rider-admin .micro { color: var(--ash); font-size: 9px; margin-bottom: 10px; }
  .rider-admin__row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .rider-admin__row label { font-family: var(--mono); font-size: 11px; text-transform: uppercase; color: var(--ash); }
  .rider-admin__row select { font-size: 14px; padding: 8px 10px; border: 1px solid var(--bone-line); background: var(--bone-raised); border-radius: var(--radius); }
  .rider-admin__row .btn { min-height: 40px; font-size: 10px; }
  .rider-admin__status { margin-top: 10px; font-size: 13px; color: var(--text-on-bone-soft); min-height: 1.3em; }
  @media (max-width: 680px) { .rider-cols { grid-template-columns: 1fr; gap: 28px; } }
</style>

<script>
  const form = document.getElementById('vouch-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('vouch-status')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const statement = (document.getElementById('vouch-statement') as HTMLTextAreaElement).value.trim();
      if (!statement) { status.textContent = 'Say what you saw.'; return; }
      status.textContent = 'Signing…';
      try {
        const res = await fetch('/api/vouches', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ vouchee_handle: form.dataset.handle, statement }),
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok) { location.reload(); } else { status.textContent = body.error || 'Something went wrong.'; }
      } catch { status.textContent = 'Network error.'; }
    });
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('.vouch-revoke')) {
    btn.addEventListener('click', async () => {
      if (!confirm('Revoke this vouch? Your name comes off it.')) return;
      try {
        const res = await fetch(`/api/vouches/${btn.dataset.id}`, { method: 'DELETE' });
        if (res.ok) location.reload();
      } catch { /* ignore */ }
    });
  }

  const postReload = async (url: string, bodyObj: unknown, confirmMsg?: string, statusEl?: HTMLElement) => {
    if (confirmMsg && !confirm(confirmMsg)) return;
    if (statusEl) statusEl.textContent = 'Working…';
    try {
      const res = await fetch(url, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyObj),
      });
      const body = await res.json().catch(() => ({}));
      if (res.ok) location.reload();
      else if (statusEl) statusEl.textContent = body.error || 'Failed.';
    } catch { if (statusEl) statusEl.textContent = 'Network error.'; }
  };

  // Admin vouch moderation — rendered wherever an admin views received
  // vouches, including the admin's own profile (so it must NOT depend on
  // the .rider-admin panel, which only renders on other riders' profiles).
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.vouch-remove')) {
    btn.addEventListener('click', () =>
      postReload(`/api/admin/vouches/${btn.dataset.id}`, {}, 'Remove this vouch (moderation)? May demote the rider.'));
  }

  // Admin rank / ban controls (only on another rider's profile).
  const admin = document.querySelector('.rider-admin') as HTMLElement | null;
  if (admin) {
    const handle = admin.dataset.handle!;
    const status = document.getElementById('admin-status')!;
    document.getElementById('admin-grant')!.addEventListener('click', () => {
      const rank = (document.getElementById('admin-rank') as HTMLSelectElement).value || null;
      postReload(`/api/admin/riders/${handle}/rank`, { rank }, undefined, status);
    });
    const banBtn = document.getElementById('admin-ban') as HTMLButtonElement;
    banBtn.addEventListener('click', () => {
      const banning = banBtn.dataset.banned !== '1';
      postReload(`/api/admin/riders/${handle}/ban`, { banned: banning },
        banning ? `Ban @${handle}? Kills their sessions and recomputes everyone they vouched.` : undefined, status);
    });
  }
</script>
