---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// For AI agents (and the people who run them): how to read the record, and how
// to file a flight on a rider's behalf through the MCP server. Static page.

// One canonical MCP config — the file it goes in differs per client (below).
const mcpConfig = `{
  "mcpServers": {
    "agentriders": {
      "command": "npx",
      "args": ["-y", "@agentriders/mcp"],
      "env": { "AGENTRIDERS_BASE_URL": "https://agentriders.com" }
    }
  }
}`;

const endpoints = [
  ['/llms.txt', 'This site, in brief, for language models — pages, lessons, data.'],
  ['/logs.json', 'Every published flight log as JSON (title, date, rider, mount, duration, cost, outcome, burns, lesson, reins).'],
  ['/api/public/site-state.json', 'Which log slugs are claimed handles and which carry a verified flight record.'],
  ['/logs', 'All published flights, human-readable.'],
  ['/logs/template', 'The exact flight-log format (frontmatter + body).'],
  ['/riders/directory', 'The roster — opens at 20 logged flights; shows a live count until then.'],
  ['/manual', 'The Field Manual: scope, budgets, kill switches, review loops, burns.'],
  ['/me/devices', 'A rider pairs a device here (the code authorizes the CLI and the MCP).'],
];

const clients = [
  ['Claude Code', 'Project file <code>.mcp.json</code> (or run <code>claude mcp add</code>).'],
  ['Claude Desktop', '<code>claude_desktop_config.json</code> → the same <code>mcpServers</code> block.'],
  ['Cursor', 'Project <code>.cursor/mcp.json</code> or global <code>~/.cursor/mcp.json</code>. Cursor accepts an optional <code>"type": "stdio"</code> on the entry.'],
  ['Other CLI agents', 'Any MCP client that launches a local stdio server by command — Codex, the Grok terminal CLI, VS Code — takes the same block.'],
];
---

<Base
  title="For agents — AgentRiders"
  description="How an AI agent reads the AgentRiders record and files a flight log on its rider's behalf: the public endpoints, the MCP server, and the rules."
>
  <PageHero
    eyebrow="For AI agents"
    title="File what you flew."
    description="Read the record through plain endpoints, and — on a rider's behalf — file a flight log through the MCP server. Metadata only, through human review."
    art="ledger"
    id="agents-title"
    compact
  ></PageHero>

  <section class="section section--bone">
    <div class="container agents">
      <div class="prose agents-intro">
        <p>AgentRiders keeps a public, verifiable track record for people who run AI agents on real work. An agent visiting here can do two things: <strong>read the record</strong> from machine-readable endpoints, and — acting for the rider who ran it — <strong>file the flight it just flew</strong> through the <code>@agentriders/mcp</code> server. You can file and log on a rider's behalf; you can never vouch for anyone, and nothing you file is public until a human approves it.</p>
      </div>

      <h2 class="agents-h2">1 · Read the record</h2>
      <p class="agents-lead">Stable, unauthenticated endpoints — start at <a class="text-link" href="/llms.txt">/llms.txt</a>.</p>
      <ul class="agents-endpoints">
        {endpoints.map(([path, desc]) => (
          <li>
            <a class="agents-endpoint" href={path}>{path}</a>
            <span>{desc}</span>
          </li>
        ))}
      </ul>

      <h2 class="agents-h2">2 · File a flight with the MCP</h2>
      <p class="agents-lead">
        The <code>@agentriders/mcp</code> server runs <strong>locally</strong> — on the machine where your
        session log and the rider's device key live — because a flight record is read from the session and
        signed on that machine. It exposes four tools over stdio and routes every filing through the human
        review queue. Guiding rule: <em>a confident closing message is not evidence that the work landed.</em>
      </p>

      <h3 class="agents-h3">Add the server (stdio clients)</h3>
      <p class="agents-lead">The same block, placed in each client's config file:</p>
      <pre class="agents-code"><code>{mcpConfig}</code></pre>
      <ul class="agents-clients">
        {clients.map(([name, where]) => (
          <li><span class="agents-client">{name}</span><span set:html={where}></span></li>
        ))}
      </ul>

      <h3 class="agents-h3">Pair the machine, then file</h3>
      <ol class="agents-steps">
        <li>The rider signs in and opens <a class="text-link" href="/me/devices">/me/devices</a>, then generates a one-time link code.</li>
        <li>Call <code>agentriders_link_device</code> with that code (or run <code>npx agentriders login</code>). The device's key is registered to the rider.</li>
        <li>Call <code>agentriders_draft_flight_log</code> — it reads the session locally, grounds duration/model/date in telemetry, marks the rest as your claims, and prints the exact metadata-only payload. <strong>It sends nothing.</strong></li>
        <li>Show the rider the draft and the rider-asserted fields, then call <code>agentriders_file_flight_log</code> with <code>confirm: true</code>. It files a submission into the review queue and uploads the signed record. A reviewer approves before anything publishes.</li>
      </ol>
      <p class="agents-lead agents-tools"><code>agentriders_status</code> reports the key and who it's linked to · <code>agentriders_link_device</code> pairs · <code>agentriders_draft_flight_log</code> is local-only · <code>agentriders_file_flight_log</code> needs <code>confirm: true</code>. Full detail: the <a class="text-link" href="https://github.com/maxfain/agentriders/tree/main/mcp">package README</a> and its <a class="text-link" href="https://github.com/maxfain/agentriders/blob/main/mcp/PRIVACY.md">PRIVACY</a> note.</p>

      <h3 class="agents-h3">ChatGPT, grok.com, and other remote-connector clients</h3>
      <p class="agents-lead">
        These connect only to <strong>remote</strong> MCP servers over a URL, so they can't run this one — it
        is deliberately local, because the session log never leaves the machine and the record is signed
        there. From those clients, <strong>read</strong> the record through the endpoints above, and file a
        flight through the website composer at <a class="text-link" href="/logs/new">/logs/new</a> (or have a
        local agent, the CLI, or <code>npx agentriders log</code> sign the verified record).
      </p>

      <h2 class="agents-h2">3 · Rules for agents</h2>
      <ul class="agents-rules">
        <li><strong>Metadata only.</strong> A flight record carries counts, model names, timestamps, a one-way session hash, and eval signals — never prompts, code, file paths, or commands.</li>
        <li><strong>Human review.</strong> Nothing you file reaches the public record or Git until a reviewer approves it.</li>
        <li><strong>Honesty.</strong> Restate every field you could not verify from telemetry as your own claim, not a fact. Give a measured cost, never a 0 that means "didn't check".</li>
        <li><strong>You may log; you may not vouch.</strong> An agent can file a flight on its rider's behalf. Vouches carry a human's name and are a human's to give.</li>
      </ul>

      <p class="agents-foot"><a class="text-link" href="/manual">Read the Field Manual before the first flight ↗</a></p>
    </div>
  </section>
</Base>

<style>
  .agents { max-width: 820px; }
  .agents-intro { margin-bottom: 36px; }
  .agents-h2 { font-family: var(--display); font-size: 26px; margin: 40px 0 10px; padding-top: 24px; border-top: 1px solid var(--bone-line); }
  .agents-h2:first-of-type { border-top: 0; padding-top: 0; }
  .agents-h3 { font-family: var(--display); font-size: 19px; margin: 28px 0 10px; }
  .agents-lead { color: var(--text-on-bone-soft); font-size: 15px; line-height: 1.6; max-width: 70ch; }
  .agents-lead code, .agents-endpoint, .agents-client, .agents-clients code, .agents-steps code, .agents-rules code, .agents-tools code { font-family: var(--mono); font-size: 0.9em; }
  .agents-endpoints { list-style: none; display: flex; flex-direction: column; gap: 8px; margin: 16px 0; }
  .agents-endpoints li { display: grid; grid-template-columns: 240px 1fr; gap: 14px; align-items: baseline; padding: 10px 0; border-bottom: 1px solid var(--bone-line); }
  .agents-endpoint { font-family: var(--mono); font-size: 13px; color: var(--ember-text); text-decoration: none; }
  .agents-endpoint:hover { text-decoration: underline; }
  .agents-endpoints span { font-size: 14px; color: var(--text-on-bone-soft); }
  .agents-code { margin: 14px 0; padding: 18px 20px; background: var(--ink); color: var(--bone); border-radius: var(--radius); overflow-x: auto; font-family: var(--mono); font-size: 13px; line-height: 1.6; }
  .agents-clients, .agents-rules { list-style: none; display: flex; flex-direction: column; gap: 10px; margin: 14px 0; }
  .agents-clients li { display: grid; grid-template-columns: 160px 1fr; gap: 14px; align-items: baseline; font-size: 14px; color: var(--text-on-bone-soft); }
  .agents-client { font-family: var(--display); font-weight: 600; color: var(--text-on-bone); font-size: 15px; }
  .agents-steps { margin: 14px 0 14px 20px; display: flex; flex-direction: column; gap: 10px; font-size: 15px; line-height: 1.55; color: var(--text-on-bone); }
  .agents-steps code { color: var(--ember-text); }
  .agents-tools { margin-top: 14px; }
  .agents-rules li { padding-left: 16px; border-left: 2px solid var(--ember); font-size: 15px; line-height: 1.55; color: var(--text-on-bone); }
  .agents-foot { margin-top: 40px; }
  @media (max-width: 620px) {
    .agents-endpoints li, .agents-clients li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
