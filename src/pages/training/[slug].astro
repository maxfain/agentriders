---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TrainingHero from '../../components/TrainingHero.astro';
import TrainingNav from '../../components/TrainingNav.astro';
import PromptComparison from '../../components/PromptComparison.astro';
import '../../styles/training.css';
import { breadcrumbs, learningResource, isoDuration, smarten } from '../../lib/seo';
export async function getStaticPaths(){return (await getCollection('training')).map(lesson=>({params:{slug:lesson.id},props:{lesson}}));}
const {lesson}=Astro.props;
const {Content,headings}=await render(lesson);
const d=lesson.data;
const lessons=(await getCollection('training')).sort((a,b)=>a.data.order-b.data.order);
const next=lessons.find(x=>x.data.order===d.order+1);
const previous=lessons.find(x=>x.data.order===d.order-1);
const published=d.published.toISOString().slice(0,10);
const updated=d.updated.toISOString().slice(0,10);
const path=`/training/${lesson.id}/`;
// <title>: the industry-term seoTitle when the lesson has one, then only " — AgentRiders" so the clamp never cuts it.
// The rail lists the body's H2s plus the questions section, which is one too.
const railHeadings=d.faq.length>0?[...headings,{depth:2,slug:'faq-title',text:'Questions riders ask'}]:headings;
const jsonLd=[
  breadcrumbs([{name:'Home',path:'/'},{name:'Flight School',path:'/training/'},{name:d.title,path}]),
  learningResource({name:d.title,description:d.description,path,level:d.level,timeRequired:isoDuration(d.duration),teaches:d.outcome,datePublished:d.published,dateModified:d.updated,authorName:d.author,authorPath:'/about/'}),
];
---
<Base title={`${d.seoTitle??d.title} — AgentRiders`} description={d.description} ogType="article" publishedTime={d.published} modifiedTime={d.updated} jsonLd={jsonLd}>
  <TrainingHero eyebrow={`Flight School / Lesson ${String(d.order).padStart(2,'0')} of 06`} title={d.title} art={d.art} compact><p class="summary">{smarten(d.summary)}</p><p class="school-hero__note micro">{d.level} PRACTICE · {d.duration} · By <a href="/about/#author" rel="author">{d.author}</a> · Published <time datetime={published}>{published}</time> · Updated <time datetime={updated}>{updated}</time></p></TrainingHero>
  <TrainingNav/>
  <section class="section section--bone school-reading"><div class="container school-reading__layout">
    <aside class="school-rail"><a class="school-back micro" href="/training/#curriculum">← ALL SIX LESSONS</a><p class="micro">YOUR FLIGHT PATH</p><ol>{lessons.map(item=><li><a href={`/training/${item.id}/`} aria-current={item.id===lesson.id?'page':undefined}><span class="micro">0{item.data.order}</span>{item.data.title}</a></li>)}</ol><nav aria-label="In this lesson"><p class="micro">IN THIS LESSON</p>{railHeadings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>
    <div class="school-reading__body">
      <div class="lesson-deliverable"><h2 class="micro">What you will leave with</h2><p>{d.outcome}</p><a class="text-link" href={d.download} download>Download the worksheet ↓</a></div>
      <PromptComparison weak={d.weakPrompt} strong={d.strongPrompt}/>
      <article class="prose school-prose"><Content/></article>
      {d.faq.length>0&&<section class="faq" aria-labelledby="faq-title"><h2 id="faq-title">Questions riders ask</h2>{d.faq.map(item=><><h3>{smarten(item.q)}</h3><p>{smarten(item.a)}</p></>)}</section>}
      <div class="school-completion"><p class="micro">TAKE THE LESSON INTO THE FIELD</p><h2>Keep the evidence.</h2><p>Save your input, output, checks, and the change you would make next time. An honest record teaches more than a perfect-looking answer.</p><a class="text-link" href="/logs/template/">Write your flight log ↗</a></div>
      <nav class="school-next" aria-label="Lesson navigation">{previous?<a href={`/training/${previous.id}/`}><span class="micro">PREVIOUS LESSON</span>{previous.data.title}</a>:<a href="/training/"><span class="micro">THE FULL PATH</span>Back to Flight School</a>}{next?<a href={`/training/${next.id}/`}><span class="micro">NEXT LESSON →</span>{next.data.title}</a>:<a href="/missions/"><span class="micro">NEXT / PUT IT TO WORK →</span>Choose a practice mission</a>}</nav>
    </div>
  </div></section>
</Base>
<script>import '../../scripts/training';</script>
