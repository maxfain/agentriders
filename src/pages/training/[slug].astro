---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TrainingHero from '../../components/TrainingHero.astro';
import TrainingNav from '../../components/TrainingNav.astro';
import PromptComparison from '../../components/PromptComparison.astro';
import '../../styles/training.css';
export async function getStaticPaths(){return (await getCollection('training')).map(lesson=>({params:{slug:lesson.id},props:{lesson}}));}
const {lesson}=Astro.props;
const {Content,headings}=await render(lesson);
const d=lesson.data;
const lessons=(await getCollection('training')).sort((a,b)=>a.data.order-b.data.order);
const next=lessons.find(x=>x.data.order===d.order+1);
const previous=lessons.find(x=>x.data.order===d.order-1);
---
<Base title={`${d.title} — Flight School — AgentRiders`} description={d.description}>
  <TrainingHero eyebrow={`Flight School / Lesson ${String(d.order).padStart(2,'0')} of 06`} title={d.title} description={d.description} art={d.art} compact><p class="school-hero__note micro">{d.level} PRACTICE · {d.duration}</p></TrainingHero>
  <TrainingNav/>
  <section class="section section--bone school-reading"><div class="container school-reading__layout">
    <aside class="school-rail"><a class="school-back micro" href="/training/#curriculum">← ALL SIX LESSONS</a><p class="micro">YOUR FLIGHT PATH</p><ol>{lessons.map(item=><li><a href={`/training/${item.id}/`} aria-current={item.id===lesson.id?'page':undefined}><span class="micro">0{item.data.order}</span>{item.data.title}</a></li>)}</ol><nav aria-label="In this lesson"><p class="micro">IN THIS LESSON</p>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>
    <div class="school-reading__body">
      <div class="lesson-deliverable"><p class="micro">WHAT YOU WILL LEAVE WITH</p><p>{d.outcome}</p><a class="text-link" href={d.download} download>Download the worksheet ↓</a></div>
      <PromptComparison weak={d.weakPrompt} strong={d.strongPrompt}/>
      <article class="prose school-prose"><Content/></article>
      <div class="school-completion"><p class="micro">TAKE THE LESSON INTO THE FIELD</p><h2>Keep the evidence.</h2><p>Save your input, output, checks, and the change you would make next time. An honest record teaches more than a perfect-looking answer.</p><a class="text-link" href="/logs/template/">Write your flight log ↗</a></div>
      <nav class="school-next" aria-label="Lesson navigation">{previous?<a href={`/training/${previous.id}/`}><span class="micro">PREVIOUS LESSON</span>{previous.data.title}</a>:<a href="/training/"><span class="micro">THE FULL PATH</span>Back to Flight School</a>}{next?<a href={`/training/${next.id}/`}><span class="micro">NEXT LESSON →</span>{next.data.title}</a>:<a href="/missions/"><span class="micro">NEXT / PUT IT TO WORK →</span>Choose a practice mission</a>}</nav>
    </div>
  </div></section>
</Base>
<script>import '../../scripts/training';</script>
