---
import Base from '../../layouts/Base.astro';
import TrainingHero from '../../components/TrainingHero.astro';
import TrainingNav from '../../components/TrainingNav.astro';
import '../../styles/training.css';
const sourceFiles=import.meta.glob('/public/training/*.md',{query:'?raw',import:'default',eager:true});
const kit=[
 {id:'mission-brief',title:'The mission brief',verb:'Give the work a destination.',description:'Define the outcome, inputs, boundaries, checks, and reviewer before the first run.',lesson:'your-first-flight'},
 {id:'acceptance-checks',title:'Acceptance checks',verb:'Make “done” observable.',description:'Separate must-pass conditions from quality judgments. Keep a baseline and catch regressions.',lesson:'teach-it-where-to-land'},
 {id:'bridle',title:'The bridle',verb:'Write down the reins.',description:'Map permissions, approval gates, budgets, stop controls, and the places they are actually enforced.',lesson:'build-the-harness'},
 {id:'burn-report',title:'The burn report',verb:'Turn the failure into a check.',description:'Record the impact, contain the problem, preserve the evidence, and verify a repair before restarting.',lesson:'when-your-dragon-breathes-fire'},
 {id:'autonomy-review',title:'The autonomy review',verb:'Give trust a paper trail.',description:'Review a specific workflow, its test cases, oversight costs, and the one boundary you propose changing.',lesson:'earn-the-longer-leash'},
 {id:'wing-handoff',title:'The wing handoff',verb:'Make every handoff explicit.',description:'Assign an owner, a narrow input and output contract, a shared budget, and a single integration decision.',lesson:'command-a-wing'},
];
---
<Base title="The rider’s field kit — Free agent workflow templates — AgentRiders" description="Download six editable Markdown templates for AI agent work: mission brief, acceptance checks, permissions, failure recovery, autonomy reviews, and multi-agent handoffs.">
  <TrainingHero eyebrow="The field kit / Six tools for better flights" title="Pack the tools." emphasis="Keep the judgment." description="Reusable templates for the work around the prompt. Open them, adapt them, and keep the evidence with the run." art="workbench"/>
  <TrainingNav/>
  <section class="section section--bone"><div class="container">
    <div class="school-heading"><div><p class="micro section-label">PLAIN MARKDOWN. YOURS TO ADAPT.</p><h2>A better setup<br/><em>starts here.</em></h2></div><p>Every file includes an illustrative example and a fill-in template. Documents describe your process; they do not configure or enforce your agent’s permissions.</p></div>
    <nav class="kit-jump" aria-label="Field kit tools">{kit.map((item,i)=><a href={`#${item.id}`}><span class="micro">0{i+1}</span>{item.title}</a>)}</nav>
    <div class="kit-list">{kit.map((item,i)=>{
      const content=String(sourceFiles[`/public/training/${item.id}.md`]||'');
      return <section class="kit-item" id={item.id} aria-labelledby={`${item.id}-title`}><div class="kit-item__intro"><span class="kit-number">0{i+1}</span><p class="micro">{item.verb}</p><h2 id={`${item.id}-title`}>{item.title}</h2><p>{item.description}</p><div class="school-actions"><a class="btn btn--ember" href={`/training/${item.id}.md`} download={`${item.id}.md`}>Download .md ↓</a><button class="school-button" type="button" data-copy-target={`kit-${item.id}`} hidden>Copy template</button><p class="copy-feedback" aria-live="polite"></p></div><a class="text-link" href={`/training/${item.lesson}/`}>Learn how to use it ↗</a></div><details class="kit-preview"><summary>Read the template<span aria-hidden="true">+</span></summary><pre><code id={`kit-${item.id}`}>{content}</code></pre></details></section>;
    })}</div>
    <div class="school-completion"><h2>The final tool is a record.</h2><p>These worksheets prepare and review the work. A flight log records what actually happened: the result, cost, burns, and what you changed.</p><a class="text-link" href="/logs/template/">Get the flight log template ↗</a></div>
  </div></section>
</Base>
<script>import '../../scripts/training';</script>
