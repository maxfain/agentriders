---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TrainingHero from '../../../components/TrainingHero.astro';
import TrainingNav from '../../../components/TrainingNav.astro';
import '../../../styles/training.css';
import { breadcrumbs, smarten } from '../../../lib/seo';

// Worksheet landing pages (docs/seo-aeo-plan.md §4.2, §4.4, decision 4). The
// six templates in public/training/*.md are raw public files, not a content
// collection, so the page reads them with import.meta.glob and renders the
// literal template inline. The raw .md keeps a noindex + rel=canonical header
// to this page (public/_headers). The "Part of" lesson is resolved from the
// training frontmatter `download`, which already points at /training/<name>.md.
// WORKSHEETS lives inside getStaticPaths: that function runs in an isolated
// scope at build, so it cannot see module-level consts.
export async function getStaticPaths() {
  const WORKSHEETS = {
    'mission-brief': {
      h1: 'The mission brief',
      lede: "A mission-brief template: write down an AI agent task's outcome, inputs, boundaries, checks, and reviewer before the first run.",
      title: 'AI agent mission brief template',
      description: 'A free mission-brief template for an AI agent task: outcome, inputs, output contract, reins, limits and reviewer, set before the first run.',
    },
    'acceptance-checks': {
      h1: 'Acceptance checks',
      lede: "An acceptance-checks template: write the checks that decide whether an AI agent's output is usable before you run it.",
      title: 'AI agent acceptance criteria template',
      description: 'A free acceptance-criteria template for AI agent work: must-pass conditions, must-not-happen boundaries, and the evidence each check inspects.',
    },
    'bridle': {
      h1: 'The bridle',
      lede: "A bridle template: map an AI agent's permissions, approval gates, and stop controls, and name where each one is actually enforced.",
      title: 'AI agent permissions worksheet',
      description: 'A free permissions template for an AI agent: reads, writes, enforcement, input handling, limits, stop conditions and recovery — the reins written down.',
    },
    'burn-report': {
      h1: 'The burn report',
      lede: 'A burn-report template: record what an AI agent did when a run went wrong, what it cost, and the check you add so it cannot recur.',
      title: 'AI agent incident report template',
      description: 'A free incident-report template for an AI agent failure: impact, containment, timeline, contributing factors and the regression check before restart.',
    },
    'autonomy-review': {
      h1: 'The autonomy review',
      lede: 'An autonomy-review template: decide whether to widen one AI agent permission, on evidence from that exact workflow, with a rollback trigger.',
      title: 'AI agent autonomy review template',
      description: "A free template to widen an AI agent's autonomy one permission at a time: current scope, the single change, the evidence, and a rollback trigger.",
    },
    'wing-handoff': {
      h1: 'The wing handoff',
      lede: 'A wing-handoff template: give each AI agent in a multi-agent run a bounded contract and a handoff that carries its evidence.',
      title: 'Multi-agent handoff template',
      description: 'A free handoff template for multi-agent runs: a per-role contract, a packet that carries evidence, and one accountable owner of the final artifact.',
    },
  } as const;
  const raw = import.meta.glob('/public/training/*.md', { query: '?raw', import: 'default', eager: true });
  const lessons = await getCollection('training');
  return Object.entries(WORKSHEETS).map(([id, meta]) => {
    // The lesson whose worksheet this is: its `download` points at the file.
    const lesson = lessons.find((l) => l.data.download === `/training/${id}.md`);
    return {
      params: { worksheet: id },
      props: {
        id,
        meta,
        content: String(raw[`/public/training/${id}.md`] ?? ''),
        lessonId: lesson?.id,
        lessonTitle: lesson?.data.title,
      },
    };
  });
}

const { id, meta, content, lessonId, lessonTitle } = Astro.props;
const path = `/training/kit/${id}/`;
const codeId = `worksheet-${id}`;
---

<Base
  title={meta.title}
  description={meta.description}
  jsonLd={breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Flight School', path: '/training/' },
    { name: 'The field kit', path: '/training/kit/' },
    { name: meta.h1, path },
  ])}
>
  <TrainingHero eyebrow="The field kit / Worksheet" title={meta.h1} art="workbench" compact>
    <p class="summary">{smarten(meta.lede)}</p>
    {lessonId && (
      <p class="school-hero__note micro">Part of: <a href={`/training/${lessonId}/`}>{lessonTitle}</a></p>
    )}
  </TrainingHero>
  <TrainingNav />
  <section class="section section--bone">
    <div class="container worksheet">
      <div class="school-actions">
        <a class="btn btn--ember" href={`/training/${id}.md`} download={`${id}.md`}>Download .md ↓</a>
        <button class="school-button" type="button" data-copy-target={codeId} hidden>Copy template</button>
        <p class="copy-feedback" aria-live="polite"></p>
      </div>
      <div class="kit-preview worksheet-preview"><pre><code id={codeId}>{content}</code></pre></div>
      <div class="school-completion">
        <p class="micro">USE IT IN THE FIELD</p>
        <h2>This is a lesson's artifact.</h2>
        <p>
          {lessonId ? (
            <>This worksheet is the artifact you fill in <a href={`/training/${lessonId}/`}>{lessonTitle}</a>. The lesson shows how to use it on one real task; this page is the template itself, ready to copy or download.</>
          ) : (
            <>This page is the template itself, ready to copy or download. It describes your process; it does not configure or enforce your agent's permissions.</>
          )}
        </p>
        <a class="text-link" href="/training/kit/">← All six worksheets</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .worksheet-preview { margin-top: 28px; }
  /* A landing page shows the whole template, not a scroll box. */
  .worksheet-preview pre { max-height: none; }
</style>
<script>import '../../../scripts/training';</script>
