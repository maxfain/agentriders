---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { logFrontmatterSchema } from '../../../lib/log-schema';
import { serializeLog } from '../../../lib/frontmatter';
import { getLogFile } from '../../../lib/github';
import type { SubmissionRow } from '../../../lib/submissions';

const { env } = Astro.locals.runtime;
const admin = Astro.locals.rider!;

const row = await env.DB.prepare(
  `SELECT s.*, r.handle AS rider_handle, r.display_name AS rider_name
   FROM submissions s JOIN riders r ON r.id = s.rider_id WHERE s.id = ?`,
)
  .bind(Astro.params.id!)
  .first<SubmissionRow & { rider_handle: string; rider_name: string }>();

if (!row) return new Response('Not found', { status: 404 });

// Opening a submitted log claims it for review.
if (row.status === 'submitted') {
  const now = new Date().toISOString();
  await env.DB.prepare(
    "UPDATE submissions SET status = 'in_review', reviewed_by = ?, updated_at = ? WHERE id = ? AND status = 'submitted'",
  )
    .bind(admin.id, now, row.id)
    .run();
  row.status = 'in_review';
}

let fmValid = true;
let frontmatter;
let serialized = '';
try {
  frontmatter = logFrontmatterSchema.parse(JSON.parse(row.frontmatter_json));
  serialized = serializeLog(frontmatter, row.body_md);
} catch {
  fmValid = false;
}

// For edits, show the current live file so the reviewer sees what changes.
let liveMarkdown: string | null = null;
if (row.kind === 'edit' && row.target_log_slug) {
  try {
    const file = await getLogFile(env, row.target_log_slug);
    liveMarkdown = file?.markdown ?? null;
  } catch {
    liveMarkdown = null;
  }
}

const canDecide = row.status === 'submitted' || row.status === 'in_review';
const d = frontmatter;
---

<Base title={`Review: ${row.title} — AgentRiders`} description="Admin review.">
  <PageHero eyebrow={`Review / ${row.status.replace('_', ' ')}`} title={row.title} description={`@${row.rider_handle} · ${row.kind}${row.kind === 'edit' ? ` of /logs/${row.target_log_slug}` : ''}`} art="ledger" id="review-title" compact></PageHero>

  <section class="section section--bone">
    <div class="container review">
      <a class="text-link" href="/admin">← Back to queue</a>

      {!fmValid ? (
        <p class="review__warn" role="alert">This submission's stored frontmatter no longer validates. Ask the rider to resave before approving.</p>
      ) : (
        <>
          <div class="review__grid">
            <dl class="review__facts">
              <div><dt>Date</dt><dd>{d.date}</dd></div>
              <div><dt>Mount</dt><dd>{d.mount}</dd></div>
              {d.model && <div><dt>Model</dt><dd>{d.model}</dd></div>}
              {d.harness && <div><dt>Harness</dt><dd>{d.harness}</dd></div>}
              <div><dt>Task</dt><dd>{d.task}</dd></div>
              <div><dt>Duration</dt><dd>{d.duration}</dd></div>
              <div><dt>Cost</dt><dd>${d.cost_usd}</dd></div>
              <div><dt>Outcome</dt><dd>{d.outcome}</dd></div>
            </dl>
            <div class="review__reins">
              <p class="micro">THE REINS</p>
              <p><strong>Scope:</strong> {d.reins.scope}</p>
              <p><strong>Budget:</strong> {d.reins.budget}</p>
              <p><strong>Kill switch:</strong> {d.reins.kill_switch}</p>
              <p><strong>Autonomy:</strong> {d.reins.autonomy}</p>
            </div>
          </div>

          {d.burns.length > 0 && (
            <div class="review__block">
              <p class="micro">BURNS ({d.burns.length})</p>
              <ul>{d.burns.map((b) => <li><strong>{b.what}</strong> — recovery: {b.recovery} · ${b.cost_usd}</li>)}</ul>
            </div>
          )}
          <div class="review__block"><p class="micro">LESSON</p><p class="review__lesson">{d.lesson}</p></div>
          {row.body_md.trim() && (
            <div class="review__block"><p class="micro">STORY (raw markdown)</p><pre class="review__pre">{row.body_md}</pre></div>
          )}

          <details class="review__file">
            <summary>The exact file that will be committed → <code>src/content/logs/{row.slug}.md</code></summary>
            <pre class="review__pre">{serialized}</pre>
          </details>
          {row.kind === 'edit' && liveMarkdown && (
            <details class="review__file">
              <summary>Current live file (for comparison)</summary>
              <pre class="review__pre">{liveMarkdown}</pre>
            </details>
          )}
        </>
      )}

      {row.reviewer_notes && (
        <div class="review__notes"><p class="micro">LAST REVIEWER NOTES</p><p>{row.reviewer_notes}</p></div>
      )}

      {canDecide && fmValid && (
        <div class="review__decide" data-id={row.id}>
          <button type="button" id="approve" class="btn btn--ember">Approve &amp; publish</button>
          <details class="review__notesform">
            <summary class="btn btn--ink">Request changes / reject</summary>
            <textarea id="notes" rows="3" maxlength="2000" aria-label="Reviewer notes" placeholder="What needs to change, or why this is rejected…"></textarea>
            <div class="review__notesbtns">
              <button type="button" id="request-changes" class="btn btn--ink">Request changes</button>
              <button type="button" id="reject" class="btn btn--ink">Reject</button>
            </div>
          </details>
          <p class="review__status" id="review-status" role="status"></p>
        </div>
      )}
      {!canDecide && (
        <p class="review__closed">This submission is <strong>{row.status.replace('_', ' ')}</strong>{row.commit_sha ? <> — committed <code>{row.commit_sha.slice(0, 7)}</code></> : ''}.</p>
      )}
    </div>
  </section>
</Base>

<style>
  .review { max-width: 820px; display: flex; flex-direction: column; gap: 22px; }
  .review__warn { padding: 14px 18px; border-left: 3px solid var(--ember); background: var(--bone-raised); }
  .review__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .review__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 20px; margin: 0; }
  .review__facts dt { font-family: var(--mono); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ash); }
  .review__facts dd { margin: 0; font-size: 15px; }
  .review__reins { border: 1px solid var(--bone-line); padding: 16px; background: var(--bone-raised); }
  .review__reins p { font-size: 14px; margin: 4px 0; }
  .review__reins .micro, .review__block .micro, .review__notes .micro { color: var(--ash); font-size: 9px; margin-bottom: 8px; }
  .review__block ul { padding-left: 18px; }
  .review__block li { font-size: 14px; margin: 4px 0; }
  .review__lesson { font-size: 17px; }
  .review__pre { white-space: pre-wrap; word-break: break-word; font-family: var(--mono); font-size: 12px; line-height: 1.5; background: var(--ink); color: #EDE5D8; padding: 16px; border-radius: var(--radius); overflow-x: auto; }
  .review__file summary { cursor: pointer; font-size: 14px; color: var(--ember-text); }
  .review__file summary code { font-size: 12px; }
  .review__notes { border-left: 3px solid var(--bone-line); padding-left: 14px; }
  .review__decide { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; border-top: 1px solid var(--bone-line); padding-top: 22px; }
  .review__notesform summary { display: inline-flex; list-style: none; }
  .review__notesform[open] summary { margin-bottom: 12px; }
  .review__notesform textarea { width: 100%; max-width: 560px; font-family: inherit; font-size: 15px; padding: 11px 13px; border: 1px solid var(--bone-line); background: var(--bone-raised); border-radius: var(--radius); }
  .review__notesbtns { display: flex; gap: 10px; margin-top: 10px; }
  .review__status { min-height: 1.4em; font-size: 14px; color: var(--text-on-bone-soft); }
  .review__closed { color: var(--text-on-bone-soft); }
  @media (max-width: 640px) { .review__grid { grid-template-columns: 1fr; } }
</style>

<script>
  const decide = document.querySelector('.review__decide') as HTMLElement | null;
  if (decide) {
    const id = decide.dataset.id!;
    const status = document.getElementById('review-status')!;

    document.getElementById('approve')!.addEventListener('click', async () => {
      if (!confirm('Approve and commit this flight log to git?')) return;
      status.textContent = 'Committing…';
      try {
        const res = await fetch(`/api/admin/submissions/${id}/approve`, { method: 'POST' });
        const body = await res.json().catch(() => ({}));
        if (res.ok) { status.textContent = `Approved — committed ${String(body.commit_sha).slice(0, 7)}. Live in ~2 min.`; setTimeout(() => location.assign('/admin'), 1500); }
        else status.textContent = body.error || 'Failed.';
      } catch { status.textContent = 'Network error.'; }
    });

    const decideWith = async (action: string) => {
      const notes = (document.getElementById('notes') as HTMLTextAreaElement).value.trim();
      if (!notes) { status.textContent = 'Notes are required.'; return; }
      status.textContent = 'Saving…';
      try {
        const res = await fetch(`/api/admin/submissions/${id}/decide`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action, notes }),
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok) { status.textContent = 'Saved.'; setTimeout(() => location.assign('/admin'), 900); }
        else status.textContent = body.error || 'Failed.';
      } catch { status.textContent = 'Network error.'; }
    };
    document.getElementById('request-changes')!.addEventListener('click', () => decideWith('request_changes'));
    document.getElementById('reject')!.addEventListener('click', () => decideWith('reject'));
  }
</script>
