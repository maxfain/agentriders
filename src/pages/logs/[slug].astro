---
import { getCollection, render } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { fetchSiteState, riderLink, isVerified } from '../../lib/build-state';
import { abs, article, breadcrumbs } from '../../lib/seo';

export async function getStaticPaths() {
  // One build-time fetch of live site state decides rider links + badges.
  const state = await fetchSiteState();
  const logs = await getCollection('logs', ({ data }) => !data.draft);
  return logs.map((log) => ({
    params: { slug: log.id },
    props: {
      log,
      riderHref: riderLink(log.data.rider, state),
      verified: isVerified(log.id, state),
    },
  }));
}

const { log, riderHref, verified } = Astro.props;
const { Content } = await render(log);
const d = log.data;
const date = d.date.toISOString().slice(0, 10);
const burns = d.burns.length;
const hasBody = log.body ? log.body.replace(/<!--[\s\S]*?-->/g, '').trim().length > 0 : false;
// The lesson leads the description (it is what a result page should show),
// the telemetry follows; Base clamps the whole to 155.
const lesson = d.lesson.trim();
const description = `${lesson}${/[.!?…]$/.test(lesson) ? '' : '.'} ${d.mount} · ${d.duration} · $${d.cost_usd} · ${burns} ${burns === 1 ? 'burn' : 'burns'}`;
const path = `/logs/${log.id}/`;
const jsonLd = [
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Flight Logs', path: '/logs/' }, { name: d.title, path }]),
  article({
    headline: d.title, description, path, datePublished: d.date,
    riderName: d.rider, riderHandle: d.rider, riderPath: riderHref ?? undefined,
    keywords: [d.mount, d.model, d.task, d.outcome].filter((k): k is string => !!k),
    datasetId: abs('/logs/#dataset'),
  }),
];
---

<Base title={`${d.title} — Flight Logs — AgentRiders`} description={description} ogType="article" publishedTime={d.date} jsonLd={jsonLd}>
  <PageHero eyebrow="Flight Log" title={d.title} description={undefined} art="ledger" compact><Fragment slot="eyebrow">Flight Log / <time datetime={date}>{date}</time></Fragment><p class="page-hero__meta">Rider: {riderHref ? <a href={riderHref}>{d.rider}</a> : d.rider}{verified && <span class="verified-badge" title="Signed by a registered device via the agentriders CLI">✦ Verified flight</span>} · <a href="/logs/">All flights</a></p></PageHero>

  <section class="section section--bone">
    <div class="container">
      <div class="flight">
        <div class="flight__body">
          {burns > 0 && (
            <div class="stack__head">
              <h2>Burns</h2>
              <ul class="burnlist">
                {d.burns.map((b) => (
                  <li>
                    <span class="what">{b.what}</span>
                    <span class="recovery">Recovery: {b.recovery} · cost ${b.cost_usd}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <div class="stack__head">
            <h2>Lesson</h2>
            <p class="lead">{d.lesson}</p>
          </div>
          {hasBody && (
            <div class="prose">
              <Content />
            </div>
          )}
        </div>

        <aside class="panel" aria-labelledby="telemetry-title">
          <h2 class="sr-only" id="telemetry-title">Flight telemetry</h2>
          <div class="panel__head">
            <span>Flight · <time datetime={date}>{date}</time></span>
            <span>{d.outcome}</span>
          </div>
          <dl class="kv">
            <div><dt>Mount</dt><dd>{d.mount}</dd></div>
            {d.model && <div><dt>Model</dt><dd>{d.model}</dd></div>}
            {d.harness && <div><dt>Harness</dt><dd>{d.harness}</dd></div>}
            <div><dt>Task</dt><dd>{d.task}</dd></div>
            <div><dt>Flight</dt><dd>{d.duration}</dd></div>
            <div><dt>Cost</dt><dd>${d.cost_usd}</dd></div>
            <div><dt>Burns</dt><dd class:list={[burns > 0 && 'burn']}>{burns}</dd></div>
            <div><dt>Outcome</dt><dd>{d.outcome}</dd></div>
          </dl>
          <div class="panel__rule"></div>
          <dl class="kv">
            <div><dt>Scope</dt><dd>{d.reins.scope}</dd></div>
            <div><dt>Budget</dt><dd>{d.reins.budget}</dd></div>
            <div><dt>Kill switch</dt><dd>{d.reins.kill_switch}</dd></div>
            <div><dt>Autonomy</dt><dd>{d.reins.autonomy}</dd></div>
          </dl>
          <div class="panel__rule"></div>
          <p class="panel__foot">Every field is public. If it isn't logged, it didn't happen.</p>
        </aside>
      </div>
    </div>
  </section>
</Base>
