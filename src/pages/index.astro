---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LogCard from '../components/LogCard.astro';
import Signup from '../components/Signup.astro';
import Artwork from '../components/Artwork.astro';
import Icon from '../components/Icon.astro';
import Arrow from '../components/Arrow.astro';
import Preflight from '../components/Preflight.astro';
import FlightAtlas from '../components/FlightAtlas.astro';
const published = (await getCollection('logs', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const ranks = [
  { name: 'Fledgling', id: 'fledgling', number: '01', label: 'Find your footing', req: 'Joined · 1 flight logged', body: 'Learning. Can read, log and ask. Everyone starts here, including the people who built this.' },
  { name: 'Rider', id: 'rider', number: '02', label: 'Earn your wings', req: '20 flights · 2 vouches from Riders', body: 'Runs agents on real work, unsupervised. Can vouch for Fledglings.' },
  { name: 'Wingleader', id: 'wingleader', number: '03', label: 'Lead the formation', req: '100 flights · runs a wing · 5 vouches', body: 'Trusted to lead others and set the reins for a team or a fleet.' },
];
const examples = [
  { mount: 'Claude Code', title: 'Migrated 214 unit tests to Vitest', duration: '3h 10m', cost: '$41', burns: 1, burn: 'Deleted a fixture, restored from git.', lesson: 'Give it a branch, not the repo.', icon: 'agent' },
  { mount: 'Custom agent', title: 'Weekly investor update, first draft', duration: '25m', cost: '$3', burns: 0, burn: 'Near miss: it invented a metric.', lesson: 'Every number now links to a source.', icon: 'tasks' },
  { mount: 'n8n + Claude', title: 'Inbound lead triage, five days', duration: '5d', cost: '$28', burns: 1, burn: 'Emailed a churned customer.', lesson: 'Scope the CRM view before the run.', icon: 'orchestration' },
];
---
<Base title="AgentRiders — The guild for people who run AI agents" description="AgentRiders is where people who run AI agents on real work learn to hold the reins, log their flights, and prove they can ride. The agents are the easy part.">
  <section class="cinema-hero section--ink" aria-labelledby="hero-title" data-scene>
    <Artwork name="flight" class="cinema-hero__art scene-art" eager alt="A rider holds the reins of a copper dragon soaring above a misty mountain range." />
    <div class="cinema-hero__shade" aria-hidden="true"></div>
    <div class="hero-atmosphere" aria-hidden="true"></div>
    <canvas class="ember-field" aria-hidden="true"></canvas>
    <svg class="hero-flight-line" viewBox="0 0 500 540" fill="none" aria-hidden="true"><path d="M50 480C-60 320 360 380 415 170S410 10 475 45" stroke="currentColor"/><circle cx="50" cy="480" r="5"/><text x="65" y="484">FIRST FLIGHT</text><circle cx="475" cy="45" r="4"/></svg>
    <div class="container cinema-hero__content">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> The guild for people who run agents</p>
      <h1 id="hero-title">The agents<br />are the<br /><em>easy part.</em></h1>
      <p class="cinema-hero__lead">Learn to hold the reins.<br />Log your flights. Prove you can ride.</p>
      <div class="cinema-hero__actions">
        <a class="btn btn--ember" href="/guild">Join the Guild <Arrow /></a>
        <a class="hero-manual" href="/manual">Explore the Field Manual <span aria-hidden="true">↗</span></a>
      </div>
      <p class="cinema-hero__note">For people running AI agents on real work.</p>
    </div>
    <div class="hero-coordinate" aria-hidden="true"><span>FIG. 01 / THE FIRST FLIGHT</span><span>AUTONOMY IS EARNED.</span></div>
    <div class="hero-bottom container">
      <p>Everyone is building dragons.<br /><strong>We're here for the riders.</strong></p>
      <a class="scroll-cue micro" href="#dragons-title">Meet your dragon <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <div class="flight-strip" aria-label="The three habits of a rider">
    <div class="container">
      <p><Icon name="shield" size={20} /><span>Set the reins.</span><span class="micro">SCOPE / BUDGET / STOP</span></p>
      <p><Icon name="tasks" size={20} /><span>Log the flight.</span><span class="micro">OUTCOMES / COST / BURNS</span></p>
      <p><Icon name="wingleader" size={20} /><span>Earn your wings.</span><span class="micro">PRACTICE / PROOF / TRUST</span></p>
    </div>
  </div>

  <section class="section section--bone bond-section" aria-labelledby="dragons-title">
    <div class="container">
      <div class="section-index"><span class="micro">01 / A powerful partnership</span><span class="micro">THE RIDER MAKES THE DIFFERENCE</span></div>
      <div class="bond-layout">
        <div class="bond-copy" data-reveal>
          <h2 id="dragons-title">Agents are<br /><em>dragons.</em></h2>
          <p class="bond-intro">Powerful. Willful.<br />Worth it, if you can ride.</p>
          <p>They have their own ideas about what you meant. The difference between a burn and a win is the rider: the scope, the judgment, and knowing when to pull the reins.</p>
          <a class="text-link" href="/about">Why we're here <Arrow /></a>
        </div>
        <figure class="bond-art">
          <Artwork name="bond" sizes="(min-width: 900px) 52vw, 100vw" alt="A rider offers an open palm to a copper dragon: trust built through patience." />
          <figcaption class="micro">FIG. 02 — TRUST IS BUILT, ONE FLIGHT AT A TIME.</figcaption>
        </figure>
      </div>
      <div class="principle-row" data-reveal>
        <div><span class="micro">01 — POWER</span><h3>Extraordinary capability.</h3><p>An agent can take on serious work. Your job is to give that power a useful direction.</p></div>
        <div><span class="micro">02 — JUDGMENT</span><h3>A mind of its own.</h3><p>It will do what you didn't say. Clear scopes and review loops make the difference.</p></div>
        <div><span class="micro">03 — TRUST</span><h3>Earned, every flight.</h3><p>Start small. Review what happened. Give it more room when the record supports it.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--bone guild-world" aria-labelledby="parts-title">
    <div class="container">
      <div class="section-heading"><div><p class="micro section-label">02 / Your place in the guild</p><h2 id="parts-title">Four parts.<br /><em>One guild.</em></h2></div><p>Learn the craft. Leave a record.<br />Find your people.<br /><span>Reading is free. Ranks are earned.</span></p></div>
      <div class="guild-grid" data-reveal>
        <article class="world-card world-card--manual">
          <div class="world-card__top"><Icon name="skills" size={28} /><span class="micro">THE FIELD MANUAL</span><span class="micro">01</span></div>
          <h3>Learn to<br />hold the reins.</h3>
          <p>Playbooks for permissions, budgets, kill switches and review loops.</p>
          <div class="manual-preview" aria-label="First three chapters">
            <a href="/manual/before-the-first-flight"><span class="micro">01</span><span>Before the first flight</span><Arrow /></a>
            <a href="/manual/reins"><span class="micro">02</span><span>Reins</span><Arrow /></a>
            <a href="/manual/the-bond"><span class="micro">03</span><span>The bond</span><Arrow /></a>
          </div>
          <a class="text-link" href="/manual">Open the Manual <Arrow /></a>
          <span class="manual-corner micro" aria-hidden="true">A FIELD GUIDE FOR THE AGE OF AGENTS</span>
        </article>
        <article class="world-card world-card--logs">
          <div class="world-card__top"><Icon name="tasks" size={28} /><span class="micro">THE FLIGHT LOGS</span><span class="micro">02</span></div>
          <h3>Leave the numbers in.</h3>
          <p>Real runs. Tokens burned. Rollbacks. Lessons worth passing on.</p>
          <div class="log-preview" aria-hidden="true"><span class="micro">TASK</span><span class="micro">COST</span><span class="micro">LESSON</span><span class="preview-rule"></span><span class="preview-rule"></span><span class="preview-rule"></span></div>
          <a class="text-link" href="/logs">Read the logs <Arrow /></a>
        </article>
        <article class="world-card world-card--riders">
          <div class="world-card__top"><Icon name="reputation" size={28} /><span class="micro">03</span></div>
          <h3>Rider profiles.</h3><p>A public track record. Proof you can ride.</p><a class="text-link" href="/riders">Meet the riders <Arrow /></a>
        </article>
        <article class="world-card world-card--guild">
          <div class="world-card__top"><Icon name="wingleader" size={28} /><span class="micro">04</span></div>
          <h3>Find your wing.</h3><p>Compare notes with people who hold the reins.</p><a class="text-link" href="/guild">Join the Guild <Arrow /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--ink rank-section" aria-labelledby="ranks-title" data-scene>
    <div class="container">
      <div class="section-heading section-heading--center"><p class="micro section-label">03 / The rider's path</p><h2 id="ranks-title">Ranks are earned.<br /><em>Never bought.</em></h2><p>Three ranks. Logged flights. Vouches from other riders.<br />Nobody skips a rung.</p></div>
      <ol class="rank-path">
        {ranks.map((rank) => (
          <li class={`rank-card rank-card--${rank.id}`} data-tilt>
            <div class="rank-card__meta micro"><span>RANK {rank.number}</span><span>{rank.label}</span></div>
            <div class="rank-card__badge"><img src={`/badges/${rank.id}.svg`} width="160" height="160" alt="" loading="lazy" /></div>
            <h3>{rank.name}</h3><p class="rank-card__req">{rank.req}</p><p class="rank-card__body">{rank.body}</p>
          </li>
        ))}
      </ol>
      <div class="rank-section__foot"><p><Icon name="reputation" size={20} /> Every flight is public. Every vouch has a name on it.</p><a class="text-link" href="/logs/template">Start with one flight <Arrow /></a></div>
    </div>
  </section>

  <FlightAtlas />

  <section class="section section--bone logs" aria-labelledby="logs-title">
    <div class="container">
      <div class="section-heading"><div><p class="micro section-label">04 / Notes from the field</p><h2 id="logs-title">From the <em>logs.</em></h2></div><a class="text-link" href="/logs">All flights <Arrow /></a></div>
      {published.length > 0 ? <div class="log-grid">{published.map((log) => <LogCard log={log} />)}</div> : (
        <>
          <p class="logs-context micro">ILLUSTRATIVE LOGS — A LOOK AT WHAT RIDERS WILL SHARE.</p>
          <div class="log-grid">
            {examples.map((log, i) => (
              <article class="log log--example">
                <div class="log__meta"><span>Example / 00{i + 1}</span><Icon name={log.icon} size={22} /></div>
                <p class="log__mount micro">{log.mount}</p><h3>{log.title}</h3>
                <dl class="stats"><div><dt>Flight</dt><dd>{log.duration}</dd></div><div><dt>Cost</dt><dd>{log.cost}</dd></div><div><dt>Burns</dt><dd class:list={{burn: log.burns > 0}}>{log.burns.toString().padStart(2, '0')}</dd></div></dl>
                <p class="log__incident">{log.burn}</p><div class="log__takeaway"><span class="micro">THE LESSON</span><p>{log.lesson}</p></div>
              </article>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <section class="section section--ink field-rules" aria-labelledby="rules-title">
    <div class="dragon-encounter" data-scene>
      <Artwork name="eye" class="dragon-encounter__art scene-art" alt="An immense amber dragon eye with faint reflections of the OpenAI, Anthropic, Gemini, and DeepSeek marks in its firelit iris." />
      <div class="container" data-reveal><p class="micro">EXTRAORDINARY POWER. HUMAN JUDGMENT.</p><h2>Power is <br />a given. <br /><em>Control <br />is a craft.</em></h2><p class="dragon-encounter__copy">The dragon brings the fire.<br />You decide what it builds.</p></div>
      <div class="encounter-caption micro" aria-hidden="true"><span>FIG. 03 / THE EYE OF THE DRAGON</span><span>A MIND OF ITS OWN.</span></div>
    </div>
    <div class="container">
      <div class="section-index"><span class="micro">05 / A code to fly by</span><Icon name="compass" /></div>
      <div class="field-rules__grid">
        <div><h2 id="rules-title">The rider's<br /><em>rules.</em></h2><ol class="rider-rules">
          <li><h3>Hold the reins.</h3><p>Every agent gets a scope, a budget and a kill switch before its first flight.</p></li>
          <li><h3>Log every flight.</h3><p>If it isn't logged, it didn't happen.</p></li>
          <li><h3>Autonomy is earned.</h3><p>Loosen the reins one flight at a time.</p></li>
          <li><h3>Never blame the dragon.</h3><p>If it burned something, the rein was too loose.</p></li>
          <li><h3>Vouch honestly.</h3><p>Your name is on every rider you vouch for.</p></li>
        </ol></div>
        <div class="field-rules__aside" data-scene><Preflight /><p class="field-note">Nobody controls a dragon.<br /><em>Riders learn where the reins are.</em></p></div>
      </div>
    </div>
  </section>

  <section class="section section--bone newsletter" id="flight-log" aria-labelledby="news-title">
    <div class="container"><div class="newsletter__text"><p class="micro section-label">THE WEEKLY FLIGHT LOG</p><h2 id="news-title">A little wiser.<br /><em>Every flight.</em></h2><p class="lead">One field-tested lesson a week, from riders who left the numbers in.</p></div><Signup /></div>
  </section>
</Base>
