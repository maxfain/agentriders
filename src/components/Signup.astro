---
import Arrow from './Arrow.astro';
interface Props { id?: string; fine?: string; }
const { id = 'email', fine = 'No vendor demos. Unsubscribe any time.' } = Astro.props;
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT?.trim();
---
{endpoint ? (
  <form class="signup" action={endpoint} method="post" data-signup>
    <label for={id}>Your email</label>
    <div class="signup__row">
      <input id={id} name="email" type="email" autocomplete="email" required placeholder="rider@example.com" />
      <button class="btn btn--ember" type="submit">Subscribe <Arrow /></button>
    </div>
    <p class="signup__fine">{fine}</p>
  </form>
) : (
  <div class="signup signup--soon">
    <p class="micro">The first issue is taking shape</p>
    <p>Newsletter signup opens soon. Until then, start with the Field Manual.</p>
    <a class="text-link" href="/manual/">Explore the Manual <Arrow /></a>
  </div>
)}

<script>
  import { track, beacon } from '../scripts/track';
  // The form posts straight to the newsletter provider, so "submitted" is
  // the last moment this page sees: fire once the browser has validated the
  // address, with beacon transport so the event outlives the navigation.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-signup]')) {
    form.addEventListener('submit', () => track('newsletter_signup', { ...beacon, form_id: form.querySelector('input')?.id }));
  }
</script>
