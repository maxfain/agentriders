---
interface Props { name: 'flight' | 'bond' | 'eye' | 'horizon'; class?: string; eager?: boolean; alt?: string; sizes?: string }
const { name, class: className, eager = false, alt = '', sizes = '100vw' } = Astro.props;
const assets = {
  flight: { file: 'first-flight', width: 1672, height: 941, sizes: [800, 1200, 1672] },
  bond: { file: 'the-bond', width: 1000, height: 1000, sizes: [600, 1000] },
  eye: { file: 'dragon-eye', width: 1672, height: 941, sizes: [800, 1200, 1672] },
  horizon: { file: 'beyond-the-clouds', width: 1672, height: 941, sizes: [800, 1200, 1672] },
};
const asset = assets[name];
---
<picture class:list={['artwork', className]}>
  <img
    src={`/images/${asset.file}-${asset.width}.webp`}
    srcset={asset.sizes.map((width) => `/images/${asset.file}-${width}.webp ${width}w`).join(', ')}
    sizes={sizes} width={asset.width} height={asset.height}
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined}
    decoding="async" alt={alt}
  />
</picture>
