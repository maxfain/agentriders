---
interface Props { name: 'flight' | 'bond'; class?: string; eager?: boolean; alt?: string; sizes?: string }
const { name, class: className, eager = false, alt = '', sizes = '100vw' } = Astro.props;
const flight = name === 'flight';
---
<picture class:list={['artwork', className]}>
  <img
    src={flight ? '/images/first-flight-1672.webp' : '/images/the-bond-1000.webp'}
    srcset={flight ? '/images/first-flight-800.webp 800w, /images/first-flight-1200.webp 1200w, /images/first-flight-1672.webp 1672w' : '/images/the-bond-600.webp 600w, /images/the-bond-1000.webp 1000w'}
    sizes={sizes} width={flight ? 1672 : 1000} height={flight ? 941 : 1000}
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined}
    decoding="async" alt={alt}
  />
</picture>
