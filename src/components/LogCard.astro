---
import type { CollectionEntry } from 'astro:content';

interface Props {
  log: CollectionEntry<'logs'>;
  /** Heading level for the card title: 2 on listing pages whose H1 the cards sit directly under, 3 inside a titled section. */
  level?: 2 | 3;
}
const { log, level = 3 } = Astro.props;
const Title = `h${level}` as 'h2' | 'h3';
const d = log.data;
const burns = d.burns.length;
const date = d.date.toISOString().slice(0, 10);
---
<article class="log">
  <div class="log__meta"><span>{date}</span><span>{d.mount}</span></div>
  <Title><a href={`/logs/${log.id}/`}>{d.title}</a></Title>
  <dl class="stats">
    <div><dt>Flight</dt><dd>{d.duration}</dd></div>
    <div><dt>Cost</dt><dd>${d.cost_usd}</dd></div>
    <div><dt>Burns</dt><dd class:list={[burns > 0 && 'burn']}>{burns}</dd></div>
  </dl>
  <div class="log__rule"></div>
  <p class="log__lesson">Lesson: {d.lesson}</p>
</article>
