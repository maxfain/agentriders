---
import Arrow from './Arrow.astro';
const lessons = [
  { slug: 'your-first-flight', title: 'Your first flight', skill: 'Start with one useful task.' },
  { slug: 'teach-it-where-to-land', title: 'Teach it where to land', skill: 'Define what done looks like.' },
  { slug: 'build-the-harness', title: 'Build the harness', skill: 'Make the boundaries real.' },
  { slug: 'when-your-dragon-breathes-fire', title: 'When your dragon breathes fire', skill: 'Recover. Learn. Try again.' },
  { slug: 'earn-the-longer-leash', title: 'Earn the longer leash', skill: 'Let the record guide autonomy.' },
  { slug: 'command-a-wing', title: 'Command a wing', skill: 'Give every agent a clear role.' },
];
---

<section class="training-invitation section--ink" aria-labelledby="training-invitation-title" data-scene>
  <picture class="training-invitation__art scene-art">
    <img src="/images/training-yard-1600.webp" srcset="/images/training-yard-800.webp 800w, /images/training-yard-1200.webp 1200w, /images/training-yard-1600.webp 1600w" sizes="100vw" width="1600" height="914" loading="lazy" decoding="async" alt="A rider and a copper dragon meet in a sunlit mountain training yard, beginning the practice that builds trust." />
  </picture>
  <div class="training-invitation__shade" aria-hidden="true"></div>
  <div class="container training-invitation__content">
    <div class="training-invitation__index micro"><span>FLIGHT SCHOOL / THE CRAFT BEGINS HERE</span><span>SIX LESSONS. REAL WORK.</span></div>
    <div class="training-invitation__copy" data-reveal>
      <p class="training-invitation__eyebrow micro"><span aria-hidden="true"></span> POWER IS ONLY THE BEGINNING.</p>
      <h2 id="training-invitation-title">Train your agent.<br /><em>Earn your wings.</em></h2>
      <p class="training-invitation__lead">Having a dragon doesn't make you a rider.</p>
      <p class="training-invitation__description">Six practical lessons for founders, engineers, and operators. Learn to brief an agent, set its boundaries, verify its work, and earn the confidence to go further.</p>
      <div class="training-invitation__actions"><a class="btn btn--ember" href="/training/">Enter Flight School <Arrow /></a><a class="text-link" href="/missions/">Choose a mission <Arrow /></a></div>
      <p class="training-invitation__note">OPEN TO EVERY RIDER · NO SIGNUP REQUIRED</p>
    </div>
    <ol class="training-invitation__lessons" aria-label="The six Flight School lessons">
      {lessons.map((lesson, index) => <li><a href={`/training/${lesson.slug}/`}><span class="training-invitation__number">0{index + 1}</span><span><strong>{lesson.title}</strong><span class="training-invitation__skill">{lesson.skill}</span></span><span class="training-invitation__arrow" aria-hidden="true">↗</span></a></li>)}
    </ol>
    <p class="training-invitation__foot micro">THE AGENT LEARNS THE TASK. THE RIDER LEARNS THE JUDGMENT.</p>
  </div>
</section>

<style>
  .training-invitation { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(50px, 6vw, 84px) 36px; border-top: 1px solid #59412b; }
  .training-invitation__art { position: absolute; inset: -3% -3% 9%; z-index: -3; display: block; }
  .training-invitation__art img { width: 100%; height: 100%; object-fit: cover; object-position: 69% center; }
  .training-invitation__shade { position: absolute; inset: 0; z-index: -2; background: linear-gradient(90deg, #16130fee, #16130fa8 41%, #16130f08 78%), linear-gradient(0deg, #16130f 3%, #16130fe8 14%, #16130f00 58%, #16130f70); }
  .training-invitation__content { position: relative; }
  .training-invitation__index { display: flex; justify-content: space-between; gap: 24px; padding-bottom: 20px; border-bottom: 1px solid #d5a6714d; color: #e4c09b; font-size: 9px; }
  .training-invitation__index > :last-child { text-align: right; }
  .training-invitation__copy { max-width: 650px; padding-top: clamp(56px, 7vw, 100px); padding-bottom: 76px; }
  .training-invitation__eyebrow { display: flex; gap: 10px; align-items: center; color: #eaba94; font-size: 9px; }
  .training-invitation__eyebrow > span { width: 5px; height: 5px; background: var(--ember); border-radius: 50%; box-shadow: 0 0 20px #e4572e; }
  .training-invitation h2 { font-size: clamp(42px, 5.5vw, 78px); font-weight: 500; line-height: 1.04; letter-spacing: -.045em; margin-top: 26px; }
  .training-invitation h2 em { color: #efbd94; }
  .training-invitation__lead { font-family: var(--display); font-size: clamp(22px, 2.2vw, 28px); margin-top: 29px; line-height: 1.3; color: #f0dfc9; }
  .training-invitation__description { max-width: 46ch; color: #d8caba; font-size: 16px; line-height: 1.75; margin-top: 16px; }
  .training-invitation__actions { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin-top: 30px; }
  .training-invitation__actions .text-link { color: var(--bone); }
  .training-invitation__note { font: 8px/1.6 var(--mono); letter-spacing: .08em; color: #c1ad94; margin-top: 21px; }
  .training-invitation__lessons { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; border-top: 1px solid #9c734a; border-left: 1px solid #614b36; background: #1c1712ee; }
  .training-invitation__lessons li { border-right: 1px solid #614b36; border-bottom: 1px solid #614b36; }
  .training-invitation__lessons a { display: grid; grid-template-columns: 21px minmax(0, 1fr) 12px; align-items: start; gap: 15px; height: 100%; padding: 23px 21px; text-decoration: none; color: #f0dfc9; transition: background .2s; }
  .training-invitation__lessons a:hover { background: #79513526; color: var(--bone); }
  .training-invitation__lessons a:focus-visible { outline-offset: -4px; }
  .training-invitation__number { font: 10px/1.7 var(--mono); color: #e9a675; padding-top: 4px; }
  .training-invitation__lessons strong { display: block; font: 500 20px/1.23 var(--display); letter-spacing: -.015em; }
  .training-invitation__skill { display: block; color: #bcad99; font-size: 12px; line-height: 1.5; margin-top: 8px; }
  .training-invitation__arrow { color: #dbad82; font-size: 16px; transition: transform .2s; }
  .training-invitation__lessons a:hover .training-invitation__arrow { transform: translate(2px, -2px); }
  .training-invitation__foot { color: #b8a28a; text-align: center; font-size: 8px; margin-top: 25px; }
  @media (max-width: 1000px) {
    .training-invitation__art img { object-position: 63% center; }
    .training-invitation__copy { max-width: 580px; }
    .training-invitation__lessons { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .training-invitation { padding-top: 26px; }
    .training-invitation__index { font-size: 8px; }
    .training-invitation__index > :last-child { display: none; }
    .training-invitation__art { inset: 0 0 auto; height: 610px; }
    .training-invitation__art img { object-position: 69% top; }
    .training-invitation__shade { background: linear-gradient(0deg, #16130f 42%, #16130f00 93%), linear-gradient(90deg, #16130f75, #16130f15), linear-gradient(180deg, #16130f80, #16130f00 18%, #16130fbb 37%); }
    .training-invitation__copy { padding-top: 225px; padding-bottom: 42px; }
    .training-invitation__eyebrow { font-size: 8px; }
    .training-invitation h2 { font-size: clamp(37px, 8.8vw, 52px); margin-top: 18px; }
    .training-invitation__lead { margin-top: 23px; font-size: 22px; }
    .training-invitation__description { font-size: 15px; }
    .training-invitation__actions { gap: 12px 24px; }
    .training-invitation__lessons { grid-template-columns: 1fr; }
    .training-invitation__lessons a { padding: 21px 18px; }
    .training-invitation__lessons strong { font-size: 21px; }
    .training-invitation__foot { max-width: 34ch; margin-inline: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .training-invitation__lessons a, .training-invitation__arrow { transition: none; }
    .training-invitation__lessons a:hover .training-invitation__arrow { transform: none; }
  }
</style>
