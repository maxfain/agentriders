---
import Mark from './Mark.astro';
---
<footer class="site-footer section--ink">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="brand" href="/" aria-label="AgentRiders home">
          <Mark />
          <span class="brand__word">AgentRiders</span>
        </a>
        <p class="footer__tag">The agents are the easy part.</p>
      </div>
      <div class="footer__cols">
        <div>
          <span>Practice</span>
          <a href="/training/">Flight School</a>
          <a href="/missions/">Missions</a>
          <a href="/training/kit/">Field kit</a>
        </div>
        <div>
          <span>Guild</span>
          <a href="/manual">Manual</a>
          <a href="/logs">Logs</a>
          <a href="/riders">Riders</a>
          <a href="/guild">Guild</a>
        </div>
        <div>
          <span>More</span>
          <a href="/about">About</a>
          <a href="/flight-log">Flight Log</a>
          <a href="/llms.txt">llms.txt</a>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© 2026 AgentRiders · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a></span>
      <span>Built by riders. Readable by dragons.</span>
    </div>
  </div>
</footer>
<style>
  .footer__cols { flex-wrap: wrap; gap: 36px clamp(28px, 5vw, 72px); }
  .footer__cols > div { min-width: 100px; }
</style>
