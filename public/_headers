# Cloudflare Pages / Workers assets headers.
# Everything under /_astro/ is content-hashed, so it can cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Private surfaces are never indexed. These paths are Pages Functions, whose
# responses get the same header from src/middleware.ts; the rules here cover
# the static forms and anything that ever lands under these paths as a file.
/admin
  X-Robots-Tag: noindex
/admin/*
  X-Robots-Tag: noindex
/me
  X-Robots-Tag: noindex
/me/*
  X-Robots-Tag: noindex
/join
  X-Robots-Tag: noindex
/join/
  X-Robots-Tag: noindex
/logs/new
  X-Robots-Tag: noindex
/logs/new/
  X-Robots-Tag: noindex

# Security headers for every static page. Dynamic (Pages Functions) responses
# don't get _headers, so src/middleware.ts sets the same set on those.
# No script-src/style-src yet: pages rely on inline styles and Astro-inlined
# scripts, so a strict policy needs its own pass with a browser check.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
